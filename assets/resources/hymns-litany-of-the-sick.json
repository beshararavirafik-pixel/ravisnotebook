{"id":"hymns-litany-of-the-sick","units":[{"title":"صلِ","role":"priest","verses":{"coptic":["+ Ϣ̀ⲗⲏⲗ."],"arabic":["+ صَلِّ."],"arabized":["+ أشليل."],"english":["+ Pray."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣ̀ⲗⲏⲗ","span":2},{"text":"صَلِّ (صيغة أمر)","span":2}]]},{"title":"للصلاة قفوا","role":"deacon","verses":{"coptic":["+ Ⲉ̀ⲡⲓ ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ ⲥ̀ⲧⲁⲑⲏⲧⲉ."],"arabic":["+ لِلصَّلَاةِ قِفُوا."],"arabized":["+ إى بي أبروس أفشي أسطاثيتى."],"english":["+ Stand up for prayer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀ⲡⲓ","span":1},{"text":"ἐπί","span":2},{"text":"لأجل، لغرض","span":1}],[{"text":"ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ","span":1},{"text":"προσευχή","span":2},{"text":"الصلاة (πρός (نحو، إلى) + εὐχή (صلاة، طلب) = προσευχή (الصلاة الموجهة نحو الله))","span":1}],[{"text":"ⲥ̀ⲧⲁⲑⲏⲧⲉ","span":1},{"text":"στάθητε","span":2},{"text":"قفوا، قوموا","span":1}],[{"text":"✠","span":4}]]},{"title":"السلام للكل","role":"priest","verses":{"coptic":["+ Ⲓ̀ⲣⲏⲛⲏ ⲡⲁⲥⲓ."],"arabic":["+ اَلسَّلَامُ لِلْكُلِّ."],"arabized":["+ إيريني باسي."],"english":["+ Peace be to all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲓ̀ⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲡⲁⲥⲓ","span":1},{"text":"πᾶσι","span":2},{"text":"للجميع (صيغة الجمع غير المباشر لـ πᾶς)","span":1}],[{"text":"✠","span":4}]]},{"title":"ولروحك","role":"people","verses":{"coptic":["+ Ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ."],"arabic":["+ وَلِرُوحِكَ."],"arabized":["+ كيه طو بنيفماتي سو."],"english":["+ And to Your Spirit."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲧⲱ","span":1},{"text":"τῷ","span":2},{"text":"مع الـ","span":1}],[{"text":"ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ","span":1},{"text":"πνεύματι","span":2},{"text":"روح","span":1}],[{"text":"ⲥⲟⲩ","span":1},{"text":"σου","span":2},{"text":"التي لك (روحك)","span":1}],[{"text":"✠","span":4}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲡⲁⲗⲓⲛ ⲟⲛ ⲙⲁⲣⲉⲛϯϩⲟ ⲉ̀Ⲫ̀ⲛⲟⲩϯ Ⲡⲓⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ: Ⲫ̀ⲓⲱⲧ ⲙ̀Ⲡⲉⲛϭⲟⲓⲥ ⲟⲩⲟϩ Ⲡⲉⲛⲛⲟⲩϯ ⲟⲩⲟϩ Ⲡⲉⲛⲥⲱⲧⲏⲣ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ.","+ Ⲧⲉⲛϯϩⲟ ⲟⲩⲟϩ ⲧⲉⲛⲧⲱⲃϩ ⲛ̀ⲧⲉⲕⲙⲉⲧⲁ̀ⲅⲁⲑⲟⲥ Ⲡⲓⲙⲁⲓⲣⲱⲙⲓ: ⲁ̀ⲣⲓⲫ̀ⲙⲉⲩⲓ Ⲡ̀ϭⲟⲓⲥ: ⲛ̀ⲛⲏⲉⲧϣⲱⲛⲓ ⲛ̀ⲧⲉ ⲡⲉⲕⲗⲁⲟⲥ."],"arabic":["+ وَأَيْضًا فَلْنَسْأَلِ اَللهَ اَلضَّابِطَ اَلْكُلَّ: أَبَا رَبِّنَا وَإِلَهِنَا وَمُخَلِّصِنَا يَسُوعَ اَلْمَسِيحِ.","+ نَسْأَلُ وَنَطْلُبُ مِنْ صَلَاحِكَ يَا مُحِبَّ اَلْبَشَرِ: اُذْكُرْ يَا رَبُّ مَرْضَى شَعْبِكَ."],"arabized":["+ پالين أون مارين تي هو إى إفنوتى پي پانتوكراطور: إفيوت إم پينتشويس أووه پيننوتى أووه پينسوتير إيسوس پيخريستوس.","+ تين تي هو أووه تين طوفه إنتيك ميت أغاثوس پي مايرومى: آري إف ميوى إپتشويس: إن نى إيت شونى إنتى پيك لاؤس."],"english":["+ And again let us ask God the Almighty: the Father of our Lord and our God and our Savior Jesus Christ.","+ We ask and beseech Your goodness O Lover of mankind: remember O Lord the sick of Your people."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲡⲁⲗⲓⲛ","span":1},{"text":"πάλιν","span":2},{"text":"أيضاً","span":1}],[{"text":"ⲟⲛ","span":2},{"text":"أيضاً","span":2}],[{"text":"ⲙⲁⲣⲉ-ⲛ-ϯϩⲟ","span":2},{"text":"فلندع – نحن – نصلي (فلنصلِّ)","span":2}],[{"text":"ⲉ̀-Ⲫ̀-ⲛⲟⲩϯ","span":2},{"text":"إلى – الـ – إله (إلى الله)","span":2}],[{"text":"Ⲡⲓ-ⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ","span":1},{"text":"παντοκράτωρ","span":2},{"text":"الـ – ضابط الكل","span":1}],[{"text":"Ⲫ̀-ⲓⲱⲧ","span":2},{"text":"الـ – أب (الآب)","span":2}],[{"text":"ⲙ̀-Ⲡⲉⲛ-ϭⲟⲓⲥ","span":2},{"text":"(أداة ربط للإضافة) – ـنا – رب (ربنا)","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"Ⲡⲉⲛ-ⲛⲟⲩϯ","span":2},{"text":"ـنا – إله (إلهنا)","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"Ⲡⲉⲛ-ⲥⲱⲧⲏⲣ","span":1},{"text":"σωτήρ","span":2},{"text":"ـنا – مخلص (مخلصنا)","span":1}],[{"text":"Ⲓⲏⲥⲟⲩⲥ","span":1},{"text":"Ἰησοῦς / יֵשׁוּעַ","span":2},{"text":"يسوع","span":1}],[{"text":"Ⲡⲓ-ⲭ̀ⲣⲓⲥⲧⲟⲥ","span":1},{"text":"Χριστός","span":2},{"text":"الـ – مسيح","span":1}],[{"text":"✠","span":4}],[{"text":"Ⲧⲉⲛ-ϯϩⲟ","span":2},{"text":"نحن – نصلي","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲧⲉⲛ-ⲧⲱⲃϩ","span":2},{"text":"نحن – نتضرع","span":2}],[{"text":"ⲛ̀ⲧⲉ-ⲕ-ⲙⲉⲧ-ⲁ̀ⲅⲁⲑⲟⲥ","span":1},{"text":"ἀγαθός","span":2},{"text":"(أداة ربط للإضافة) – ـك – (مقطع المعنى) – صالح (صلاحك)","span":1}],[{"text":"Ⲡⲓ-ⲙⲁⲓ-ⲣⲱⲙⲓ","span":1},{"text":"φιλάνθρωπος","span":2},{"text":"الـ – محب – بشر (محب البشر)","span":1}],[{"text":"ⲁ̀ⲣⲓ-ⲫ̀-ⲙⲉⲩⲓ","span":2},{"text":"اصنع – الـ – ذكر (اذكر)","span":2}],[{"text":"Ⲡ̀-ϭⲟⲓⲥ","span":2},{"text":"الـ – رب","span":2}],[{"text":"ⲛ̀-ⲛⲏ-ⲉⲧ-ϣⲱⲛⲓ","span":2},{"text":"(أداة ربط للإضافة) – أولئك – الذين – يمرضون (المرضى)","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط للإضافة)","span":2}],[{"text":"ⲡⲉⲕ-ⲗⲁⲟⲥ","span":2},{"text":"ـك – شعب (شعبك)","span":2}]]},{"title":"مرد أوشية المرضى","role":"deacon","verses":{"coptic":["+ Ⲧⲱⲃϩ ⲉ̀ϫⲉⲛ ⲛⲉⲛⲓⲟϯ ⲛⲉⲙ ⲛⲉⲛⲥ̀ⲛⲏⲟⲩ ⲉⲧϣⲱⲛⲓ ϧⲉⲛ ϫⲓⲛϣⲱⲛⲓ ⲛⲓⲃⲉⲛ: ⲓ̀ⲧⲉ ϧⲉⲛ ⲡⲁⲓⲧⲟⲡⲟⲥ ⲓ̀ⲧⲉ ϧⲉⲛ ⲙⲁⲓ ⲛⲓⲃⲉⲛ: ϩⲓⲛⲁ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲛⲟⲩϯ ⲉⲣϩ̀ⲙⲟⲧ ⲛⲁⲛ ⲛⲉⲙⲱⲟⲩ ⲙ̀ⲡⲓⲟⲩϫⲁⲓ ⲛⲉⲙ ⲡⲓⲧⲁⲗϭⲟ: ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ."],"arabic":["+ اُطْلُبُوا عَنْ آبَائِنَا وَإِخْوَتِنَا اَلْمَرْضَى بِكُلِّ مَرَضٍ: إِنْ كَانَ فِي هَذَا اَلْمَسْكَنِ أَوْ بِكُلِّ مَوْضِعٍ: لِكَيْ اَلْمَسِيحُ إِلَهُنَا يُنْعِمَ لَنَا وَلَهُمْ بِالْعَافِيَةِ وَالشِّفَاءِ: وَيَغْفِرَ لَنَا خَطَايَانَا."],"arabized":["+ طوڤ إيچين نينيوتى نيم نين إسنيهو إتشونى خين چين شونى نيڤين: إيتى خين پاي توبوس إيتى خين ماي نيڤين: هينا إنتى پيخريستوس إفنوتى إره موت نان نيموؤو إمپي أوجاي نيم پيتالشو: إنتيف كا نين نوڤى نان إيڤول."],"english":["+ Pray for our fathers and our brothers who are sick with every sickness: whether they are in this dwelling or in every place: that Christ our God may grant us and them health and healing: and forgive us our sins."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲧⲱⲃϩ","span":2},{"text":"صلوا (صلِّ)","span":2}],[{"text":"ⲉ̀ϫⲉⲛ","span":2},{"text":"من أجل","span":2}],[{"text":"ⲛⲉⲛ-ⲓⲟϯ","span":2},{"text":"ـنا – آباء (آبائنا)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲉⲛ-ⲥ̀ⲛⲏⲟⲩ","span":2},{"text":"ـنا – إخوة (إخوتنا)","span":2}],[{"text":"ⲉⲧ-ϣⲱⲛⲓ","span":2},{"text":"الذين – يمرضون (المرضى)","span":2}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ϫⲓⲛ-ϣⲱⲛⲓ","span":2},{"text":"حالة – مرض (أمراض)","span":2}],[{"text":"ⲛⲓⲃⲉⲛ","span":2},{"text":"كل","span":2}],[{"text":"✠","span":4}],[{"text":"ⲓ̀ⲧⲉ","span":1},{"text":"εἴτε","span":2},{"text":"سواء","span":1}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ⲡⲁⲓ-ⲧⲟⲡⲟⲥ","span":1},{"text":"τόπος","span":2},{"text":"هذا – مكان (الموضع)","span":1}],[{"text":"ⲓ̀ⲧⲉ","span":1},{"text":"εἴτε","span":2},{"text":"سواء","span":1}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ⲙⲁⲓ","span":2},{"text":"مكان (أماكن)","span":2}],[{"text":"ⲛⲓⲃⲉⲛ","span":2},{"text":"كل","span":2}],[{"text":"✠","span":4}],[{"text":"ϩⲓⲛⲁ","span":1},{"text":"ἵνα","span":2},{"text":"لكي","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط)","span":2}],[{"text":"Ⲡⲓ-ⲭ̀ⲣⲓⲥⲧⲟⲥ","span":1},{"text":"Χριστός","span":2},{"text":"الـ – مسيح","span":1}],[{"text":"Ⲡⲉⲛ-ⲛⲟⲩϯ","span":2},{"text":"ـنا – إله (إلهنا)","span":2}],[{"text":"ⲉⲣ-ϩ̀ⲙⲟⲧ","span":2},{"text":"يعمل – نعمة (ينعم)","span":2}],[{"text":"ⲛⲁⲛ","span":2},{"text":"علينا","span":2}],[{"text":"ⲛⲉⲙⲱⲟⲩ","span":2},{"text":"معهم","span":2}],[{"text":"ⲙ̀-ⲡⲓ-ⲟⲩϫⲁⲓ","span":2},{"text":"(أداة ربط) – الـ – خلاص (بالخلاص)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲡⲓ-ⲧⲁⲗϭⲟ","span":2},{"text":"الـ – شفاء","span":2}],[{"text":"✠","span":4}],[{"text":"ⲛ̀ⲧⲉϥ-ⲭⲁ","span":2},{"text":"لكي هو – يغفر (يغفر)","span":2}],[{"text":"ⲛⲉⲛ-ⲛⲟⲃⲓ","span":2},{"text":"ـنا – خطايا (خطايانا)","span":2}],[{"text":"ⲛⲁⲛ","span":2},{"text":"لنا","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجا (يغفر لنا)","span":2}]]},{"title":"يا رب ارحم","role":"people","verses":{"coptic":["+ Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ."],"arabic":["+ يَا رَبُّ ارْحَمْ."],"arabized":["+ كيريه اليسون."],"english":["+ Lord have mercy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲩⲣⲓⲉ","span":1},{"text":"κύριε","span":2},{"text":"يا رب","span":1}],[{"text":"ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ","span":1},{"text":"ἐλέησον","span":2},{"text":"ارحم","span":1}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲉ̀ⲁⲕϫⲉⲙ ⲡⲟⲩϣⲓⲛⲓ ϧⲉⲛ ϩⲁⲛⲛⲁⲓ ⲛⲉⲙ ϩⲁⲛⲙⲉⲧϣⲉⲛϩⲏⲧ ⲙⲁⲧⲁⲗϭⲱⲟⲩ.","+ Ⲁ̀ⲗⲓⲟⲩⲓ̀ ⲉ̀ⲃⲟⲗ ϩⲁⲣⲱⲟⲩ ⲛⲉⲙ ⲉ̀ⲃⲟⲗ ϩⲁⲣⲟⲛ ⲛ̀ϣⲱⲛⲓ ⲛⲓⲃⲉⲛ ⲛⲉⲙ ⲓⲁⲃⲓ ⲛⲓⲃⲉⲛ: ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ ⲛ̀ⲧⲉ ⲛⲓϣⲱⲛⲓ ϭⲟϫⲓ ⲛ̀ⲥⲱϥ.","+ Ⲛⲏⲉ̀ⲧⲁⲩⲱⲥⲕ ⲉⲩϣ̀ⲧⲏⲟⲩⲧ ϧⲉⲛ ⲛⲓⲓⲁⲃⲓ ⲙⲁⲧⲟⲩⲛⲟⲥⲟⲩ ⲟⲩⲟϩ ⲙⲁⲛⲟⲙϯ ⲛⲱⲟⲩ.","+ Ⲛⲏⲉⲧⲧ̀ϩⲉⲙⲕⲏⲟⲩⲧ ⲛ̀ⲧⲟⲧⲟⲩ ⲛ̀ⲛⲓⲡ̀ⲛⲉⲩⲙⲁ ⲛ̀ⲁ̀ⲕⲁⲑⲁⲣⲧⲟⲛ ⲁ̀ⲣⲓⲧⲟⲩ ⲧⲏⲣⲟⲩ ⲛ̀ⲣⲉⲙϩⲉ.","+ Ⲛⲏⲉⲧ ϧⲉⲛ ⲛⲓϣ̀ⲧⲉⲕⲱⲟⲩ: ⲓⲉ ⲛⲓⲙⲉⲧⲁ̀ⲗⲱⲥ: ⲓⲉ ⲛⲏⲉⲧⲭⲏ ϧⲉⲛ ⲛⲓⲉⲝⲟⲣⲓⲥⲧⲓⲁ: ⲓⲉ ⲛⲓⲉⲭⲙⲁⲗⲱⲥⲓⲁ: ⲓⲉ ⲛⲏⲉ̀ⲧⲟⲩⲁ̀ⲙⲟⲛⲓ ⲙ̀ⲙⲱⲟⲩ ϧⲉⲛ ⲟⲩⲙⲉⲧⲃⲱⲕ ⲉⲥⲉⲛϣⲁϣⲓ: Ⲡ̀ϭⲟⲓⲥ ⲁ̀ⲣⲓⲧⲟⲩ ⲧⲏⲣⲟⲩ ⲛ̀ⲣⲉⲙϩⲉ ⲟⲩⲟϩ ⲛⲁⲓ ⲛⲱⲟⲩ.","+ Ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉⲧⲃⲱⲗ ⲛ̀ⲛⲏⲉⲧⲥⲱⲛϩ ⲉ̀ⲃⲟⲗ: ⲟⲩⲟϩ ⲉⲧⲧⲁϩⲟ ⲉ̀ⲣⲁⲧⲟⲩ ⲛ̀ⲛⲏⲉ̀ⲧⲁⲩⲣⲁϧⲧⲟⲩ ⲉ̀ϧ̀ⲣⲏⲓ. Ϯϩⲉⲗⲡⲓⲥ ⲛ̀ⲧⲉ ⲛⲏⲉ̀ⲧⲉ ⲙ̀ⲙⲟⲛ ⲧⲟⲩ ϩⲉⲗⲡⲓⲥ: ϯⲃⲟⲏ̀ⲑⲓⲁ ⲛ̀ⲧⲉ ⲛⲏⲉ̀ⲧⲉ ⲙ̀ⲙⲟⲛ ⲧⲟⲩ ⲃⲟⲏ̀ⲑⲟⲥ. Ⲑ̀ⲛⲟⲙϯ ⲛ̀ⲧⲉ ⲛⲏⲉⲧⲟⲓ ⲛ̀ⲕⲟⲩϫⲓ ⲛ̀ϩⲏⲧ: ⲡⲓⲗⲩⲙⲏⲛ ⲛ̀ⲧⲉ ⲛⲏⲉⲧⲭⲏ ϧⲉⲛ ⲡⲓⲭⲓⲙⲱⲛ.","+ Ⲯⲩⲭⲏ ⲛⲓⲃⲉⲛ ⲉⲧϩⲉϫϩⲱϫ ⲟⲩⲟϩ ⲉ̀ⲧⲟⲩⲁ̀ⲙⲟⲛⲓ ⲉ̀ϫⲱⲟⲩ. Ⲙⲟⲓ ⲛⲱⲟⲩ Ⲡ̀ϭⲟⲓⲥ ⲛ̀ⲟⲩⲛⲁⲓ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩⲙ̀ⲧⲟⲛ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩⲭ̀ⲃⲟⲃ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩϩ̀ⲙⲟⲧ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩⲃⲟⲏ̀ⲑⲓⲁ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩⲥⲱⲧⲏⲣⲓⲁ: ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲟⲩⲙⲉⲧⲣⲉϥⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲟⲩⲛⲟⲃⲓ ⲛⲉⲙ ⲛⲟⲩⲁ̀ⲛⲟⲙⲓⲁ.","+ Ⲁ̀ⲛⲟⲛ ⲇⲉ ϩⲱⲛ Ⲡ̀ϭⲟⲓⲥ ⲛⲓϣⲱⲛⲓ ⲛ̀ⲧⲉ ⲛⲉⲛⲯⲩⲭⲏ ⲙⲁⲧⲁⲗϭⲱⲟⲩ: ⲟⲩⲟϩ ⲛⲁ ⲛⲉⲛⲕⲉⲥⲱⲙⲁ ⲁ̀ⲣⲓⲫⲁϧⲣⲓ ⲉ̀ⲣⲱⲟⲩ.","+ Ⲡⲓⲥⲏⲓⲛⲓ ⲙ̀ⲙⲏⲓ ⲛ̀ⲧⲉ ⲛⲉⲛⲯⲩⲭⲏ ⲛⲉⲙ ⲛⲉⲛⲥⲱⲙⲁ: Ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ ⲛ̀ⲧⲉ ⲥⲁⲣⲝ ⲛⲓⲃⲉⲛ: ϫⲉⲙⲡⲉⲛϣⲓⲛⲓ ϧⲉⲛ ⲡⲉⲕⲟⲩϫⲁⲓ."],"arabic":["+ تَعَهَّدْهُمْ بِالْمَرَاحِمِ وَالرَّأَفَاتِ: اِشْفِهِمْ.","+ اِنْزِعْ عَنْهُمْ وَعَنَّا كُلَّ مَرَضٍ وَكُلَّ سَقَمٍ: وَرُوحَ الْأَمْرَاضِ اِطْرُدْهُ.","+ وَالَّذِينَ أَبْطَأُوا مَطْرُوحِينَ فِي الْأَمْرَاضِ: أَقِمْهُمْ وَعَزِّهِمْ.","+ وَالْمُعَذَّبِينَ مِنَ الْأَرْوَاحِ النَّجِسَةِ: اِعْتِقْهُمْ جَمِيعًا.","+ اَلَّذِينَ فِي السُّجُونِ أَوِ الْمَطَابِقِ: أَوِ الَّذِينَ فِي النَّفْيِ أَوِ السَّبْيِ أَوِ الْمَقْبُوضِ عَلَيْهِمْ فِي عُبُودِيَّةٍ مُرَّةٍ: يَا رَبُّ اِعْتِقْهُمْ جَمِيعَهُمْ وَارْحَمْهُمْ.","+ لِأَنَّكَ أَنْتَ الَّذِي تَحُلُّ الْمَرْبُوطِينَ: وَتُقِيمُ السَّاقِطِينَ: رَجَاءَ مَنْ لَيْسَ لَهُ رَجَاءٌ: وَمُعِينَ مَنْ لَيْسَ لَهُ مُعِينٌ: عَزَاءَ صَغِيرِي الْقُلُوبِ: مِينَاءَ الَّذِينَ فِي الْعَاصِفِ.","+ كُلُّ اَلْأَنْفُسِ اَلْمُتَضَايِقَةِ: وَالْمَقْبُوضِ عَلَيْهَا: أَعْطِهَا يَا رَبُّ رَحْمَةً: أَعْطِهَا نِيَاحاً: أَعْطِهَا بُرُودَةً: أَعْطِهَا نِعْمَةً: أَعْطِهَا مَعُونَةً: أَعْطِهَا خَلَاصاً: أَعْطِهَا غُفْرَانَ خَطَايَاهَا وَآثَامِهَا.","+ وَنَحْنُ أَيْضاً يَا رَبُّ: أَمْرَاضَ نُفُوسِنَا: اِشْفِهَا وَاَلَّتِي لِأَجْسَادِنَا: عَافِهَا.","+ أَيُّهَا اَلطَّبِيبُ اَلْحَقِيقِيُّ اَلَّذِي لِأَنْفُسِنَا: وَأَجْسَادِنَا: يَا مُدَبِّرَ كُلِّ جَسَدٍ: تَعَهَّدْنَا بِخَلَاصِكَ."],"arabized":["+ إي آك چيم پوي شيني خين هان ناي نيم هان ميت شين هيت ماتال تشوؤو.","+ آلي أو إي إيڤول هارؤو نيم إيڤول هارون إن شوني نيڤين نيم إيابي نيڤين: پي إپنيڤما إنتى ني شوني تشوچي إن سوڤ.","+ ني إيتاو أوسك إي أو شتيهؤوت خين ني إيابي ماتؤونوسؤو أووه مانومتشي نؤو.","+ ني إيت هيمكيؤوت إنتوتؤو إن ني إپنيڤما إن آكاثارطون آريتؤو تيرو إن ريم هي.","+ ني إيت خين ني شتيكؤو: إي ني ميتالوس: إي ني إيت خي خين ني إكسوريستيا: إي ني إيخمالوسيا: إي ني إيت أو آموني إممؤو خين أو ميت پوك إيسين شاشي: إپتشويس آريتؤو تيرو إن ريم هي أووه ناي نؤو.","+ چى إنثوك پيت پول إن ني إيت سون إيڤول: أووه إتتاهو إي راتؤو إن ني إيت آو راختؤو إي خري. تي هيلپيس إنتى ني إيتى إممؤن تؤو هيلپيس: تي ڤوئثيا إنتى ني إيتى إممؤن تؤو ڤوئثوس. ثينومتشي إنتى ني إيت أو إي إن كوجي إن هيت: پي ليمين إنتى ني إيت خي خين پي خيمون.","+ پسيشي نيڤين إت هيچ هيچ أووه إيت أو آموني إي چؤو. موي نؤو إپتشويس إن أو ناي: موي نؤو إن أو ميتون: موي نؤو إن أو إخڤوب: موي نؤو إن أو إهموت: موي نؤو إن أو ڤوئثيا: موي نؤو إن أو صوتيريا: موي نؤو إن أو ميت ريف خو إيڤول إنتى نونوبي نيم نوي أنوميا.","+ آنون دي هون إپتشويس ني شوني إنتى نينپسيشي ماتال تشوؤو: أووه نا نين كيسوما آري فاخري إي رؤو.","+ پي سيني ميمي إنتى نينپسيشي نيم نين سوما: پي إبيسكوبوس إنتى ساركس نيڤين: چيم پين شيني خين پيك أوجاي."],"english":["+ Visit them with mercies and compassions: heal them.","+ Remove from them and from us every sickness and every infirmity: and drive away the spirit of diseases.","+ And those who have lingered cast down in illnesses: raise them up and comfort them.","+ And those tormented by unclean spirits: deliver them all.","+ Those who are in prisons or in dungeons: or those who are in exile or in captivity or held in bitter servitude: O Lord deliver them all and have mercy upon them.","+ For You are the One who looses the bound: and raises up the fallen: the hope of those who have no hope: and the helper of those who have no helper: the consolation of the faint-hearted: the harbor of those in the storm.","+ All the distressed souls: and those held captive: grant them O Lord mercy: grant them rest: grant them refreshment: grant them grace: grant them aid: grant them salvation: grant them forgiveness of their sins and iniquities.","+ And us also O Lord: the illnesses of our souls: heal them and those of our bodies: restore them.","+ O true Physician of our souls: and our bodies: O Governor of every flesh: visit us with Your salvation."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀-ⲁⲕ-ϫⲉⲙ","span":2},{"text":"إذ – أنت قد – وجدت (إذ وجدت)","span":2}],[{"text":"ⲡ-ⲟⲩϣⲓⲛⲓ","span":2},{"text":"الـ – افتقاد (افتقادنا)","span":2}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ϩⲁⲛ-ⲛⲁⲓ","span":2},{"text":"(أداة نكرة للجمع) – مراحم","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ϩⲁⲛ-ⲙⲉⲧ-ϣⲉⲛϩⲏⲧ","span":2},{"text":"(أداة نكرة للجمع) – (مقطع المعنى) – طول – أناة (طول أناة)","span":2}],[{"text":"ⲙⲁ-ⲧⲁⲗϭⲱ-ⲟⲩ","span":2},{"text":"اجعل – شفاء – هم (اشفهم)","span":2}],[{"text":"✠","span":4}],[{"text":"Ⲁ̀-ⲗⲓ-ⲟⲩⲓ̀","span":2},{"text":"قد – أنا – أبعدت (أبعد)","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجا","span":2}],[{"text":"ϩⲁⲣⲱⲟⲩ","span":2},{"text":"عنهم","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجا","span":2}],[{"text":"ϩⲁⲣⲟⲛ","span":2},{"text":"عنا","span":2}],[{"text":"