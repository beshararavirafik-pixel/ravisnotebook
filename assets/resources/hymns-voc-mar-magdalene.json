{"id":"hymns-voc-mar-magdalene","units":[{"title":"أرباع الناقوس لمريم المجدلية","role":"people","verses":{"coptic":["+ Ⲭⲉⲣⲉ ⲛⲉ ⲱ̀ ϯⲁ̀ⲅⲓⲁ: Ⲙⲁⲣⲓⲁ ϯⲙⲁⲅⲇⲁⲗⲓⲛⲏ: ⲭⲉⲣⲉ ϯϩⲓⲱ̀ⲓϣ: ⲛ̀ⲧⲉ ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ."],"arabic":["+ اَلسَّلَامُ لَكِ أَيَّتُهَا اَلْقِدِّيسَةُ: مَرْيَمُ اَلْمَجْدَلِيَّةُ: اَلسَّلَامُ لِلْمُبَشِّرَةِ: بِالْقِيَامَةِ."],"english":["+ Hail to you O Saint: Mary Magdalene: Hail to the preacher: of the Resurrection."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲭⲉⲣⲉ","span":1},{"text":"χαῖρε","span":2},{"text":"افرحي (السلام لكِ)","span":1}],[{"text":"ⲛⲉ","span":2},{"text":"لكِ","span":2}],[{"text":"ⲱ̀","span":2},{"text":"يا (أداة نداء)","span":2}],[{"text":"ϯ-ⲁ̀ⲅⲓⲁ","span":1},{"text":"ἁγία","span":2},{"text":"الـ - قديسة","span":1}],[{"text":"Ⲙⲁⲣⲓⲁ","span":1},{"text":"Μαρία / מִרְיָם","span":2},{"text":"مريم","span":1}],[{"text":"ϯ-ⲙⲁⲅⲇⲁⲗⲓⲛⲏ","span":1},{"text":"Μαγδαληνή","span":2},{"text":"الـ - مجدلية","span":1}],[{"text":"ⲭⲉⲣⲉ","span":1},{"text":"χαῖρε","span":2},{"text":"افرحي (السلام لكِ)","span":1}],[{"text":"ϯ-ϩⲓⲱ̀ⲓϣ","span":2},{"text":"الـ - مبشرة","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط للإضافة)","span":2}],[{"text":"ϯ-ⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ","span":1},{"text":"ἀνάστασις","span":2},{"text":"الـ - قيامة","span":1}]]}],"files":[]}
