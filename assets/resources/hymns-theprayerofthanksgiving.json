ⲟⲏⲑⲓⲛ ⲉ̀ⲣⲟⲛ: ⲛ̀ⲧⲉϥϭⲓ ⲛ̀ⲛⲓϯϩⲟ ⲛⲉⲙ ⲛⲓⲧⲱⲃϩ ⲛ̀ⲧⲉ ⲛⲏⲉⲑⲟⲩⲁⲃ ⲛ̀ⲧⲁϥ: ⲛ̀ⲧⲟⲧⲟⲩ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ ⲉ̀ⲡⲓⲁ̀ⲅⲁⲑⲟⲛ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ…"],"arabic":["+ اُطْلُبُوا لِكَيْ يَرْحَمَنَا اَللهُ: وَيَتَرَأَّفَ عَلَيْنَا وَيَسْمَعَنَا: وَيُعِينَنَا: وَيَقْبَلَ سُؤَالَاتِ وَطِلْبَاتِ قِدِّيسِيهِ: مِنْهُمْ بِالصَّلَاحِ عَنَّا فِي كُلِّ حِينٍ."],"english":["+ Pray that God may have mercy on us: and have compassion upon us, and hear us: and help us: and accept the supplications and prayers of His saints on our behalf for goodness at all times…"]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲧⲱⲃϩ","span":2},{"text":"توسل، اطلب","span":2}],[{"text":"ϩⲓⲛⲁ","span":1},{"text":"ἵνα","span":2},{"text":"بغية أن","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"لكي","span":2}],[{"text":"Ⲫ̀-ⲛⲟⲩϯ","span":2},{"text":"الـ – إله","span":2}],[{"text":"ⲛⲁⲓ","span":2},{"text":"يرحم، يتحنن","span":2}],[{"text":"ⲛⲁ-ⲛ","span":2},{"text":"لِـ – ـنا (لنا)","span":2}],[{"text":"ⲛ̀ⲧⲉϥ-ϣⲉⲛ-ϩⲏⲧ","span":2},{"text":"لكي – هو – يكثر – قلب (ليتراءف)","span":2}],[{"text":"ϧⲁⲣⲟ-ⲛ","span":2},{"text":"على – ـنا (علينا)","span":2}],[{"text":"ⲛ̀ⲧⲉϥ-ⲥⲱⲧⲉⲙ","span":2},{"text":"لكي – هو – يسمع (ليسمع)","span":2}],[{"text":"ⲉ̀ⲣⲟ-ⲛ","span":2},{"text":"إلى – ـنا (إلينا)","span":2}],[{"text":"ⲛ̀ⲧⲉϥ-ⲉ̀ⲣ-ⲃⲟⲏⲑⲓⲛ","span":1},{"text":"βοηθεῖν","span":2},{"text":"لكي – هو – يصنع – معونة (ليعيننا)","span":1}],[{"text":"ⲉ̀ⲣⲟ-ⲛ","span":2},{"text":"إلى – ـنا (إلينا)","span":2}],[{"text":"ⲛ̀ⲧⲉϥ-ϭⲓ","span":2},{"text":"لكي – هو – يأخذ (ليقبل)","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ϯϩⲟ","span":2},{"text":"أداة ربط المفعول به – الـ – سؤالات (السجدات)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲓ-ⲧⲱⲃϩ","span":2},{"text":"الـ – طلبات","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"التي لِـ","span":2}],[{"text":"ⲛⲏ-ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"أولئك – الـ – قديسون","span":2}],[{"text":"ⲛ̀ⲧⲁ-ϥ","span":2},{"text":"الذين لِـ – ـه (الذين له)","span":2}],[{"text":"ⲛ̀ⲧⲟⲧ-ⲟⲩ","span":2},{"text":"من يد – ـهم (من أيديهم)","span":2}],[{"text":"ⲉ̀ϩ̀ⲣⲏⲓ","span":2},{"text":"إلى فوق","span":2}],[{"text":"ⲉ̀ϫⲱ-ⲛ","span":2},{"text":"على – ـنا (علينا، عنا)","span":2}],[{"text":"ⲉ̀-ⲡⲓ-ⲁ̀ⲅⲁⲑⲟⲛ","span":1},{"text":"ἀγαθόν","span":2},{"text":"بـِ – الـ – صلاح (بالصلاح)","span":1}],[{"text":"ⲛ̀-ⲥⲏⲟⲩ","span":2},{"text":"الذي لِـ – أوقات","span":2}],[{"text":"ⲛⲓⲃⲉⲛ","span":2},{"text":"كل","span":2}]]},{"title":"أطلبوا في وجود الأب البطريرك أو المطران أو الأسقف","role":"deacon","verses":{"coptic":["+ ⲛ̀ⲧⲉϥⲁ̀ⲣⲉϩ ⲉ̀ⲡ̀ⲱⲛϧ ⲛⲉⲙ ⲡ̀ⲧⲁϩⲟ ⲉ̀ⲣⲁⲧϥ ⲙ̀ⲡⲉⲛⲓⲱⲧ ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲛ̀ⲁⲣⲭⲓⲉ̀ⲣⲉⲩⲥ ⲡⲁⲡⲁ ⲁⲃⲃⲁ (ⲛⲓⲙ) ⲛⲉⲙ ⲡⲉϥⲕⲉϣ̀ⲫⲏⲣ ⲛ̀ⲗⲓⲧⲟⲩⲣⲅⲟⲥ ⲡⲉⲛⲓⲱⲧ ⲛ̀ⲉⲡⲓⲥⲕⲟⲡⲟⲥ (ⲙ̀ⲙⲏⲧⲣⲟⲡⲟⲗⲏⲧⲏⲥ) ⲁⲃⲃⲁ (ⲛⲓⲙ)."],"arabic":["+ وَأَنْ يَحْفَظَ حَيَاةَ وَقِيَامَ أَبِينَا الْمُكَرَّمِ الْبَابَا الأَنْبَا (…): وَشَرِيكِهِ فِي الْخِدْمَةِ الرَّسُولِيَّةِ أَبِينَا الأُسْقُفِ (الْمُطْرَانِ) أَنْبَا (…)."],"english":["+ And that He may keep the life and standing of our honored father, the Pope, Abba (…), and his partner in the apostolic ministry, our father the Bishop (Metropolitan), Abba (…)."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"ⲛ̀ⲧⲉϥ-ⲁ̀ⲣⲉϩ","span":2},{"text":"لكي هو – يحفظ (ليحفظ، ليحافظ)","span":2}],[{"text":"ⲉ̀-ⲡ̀-ⲱⲛϧ","span":2},{"text":"على – الـ – حياة","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲡ̀-ⲧⲁϩⲟ","span":2},{"text":"الـ – قيام","span":2}],[{"text":"ⲉ̀ⲣⲁⲧ-ϥ","span":2},{"text":"قائماً – ـه (قيامته)","span":2}],[{"text":"ⲙ̀-ⲡⲉⲛ-ⲓⲱⲧ","span":2},{"text":"الذين لـ – ـنا – أب (أبينا)","span":2}],[{"text":"ⲉⲧ-ⲧⲁⲓⲏⲟⲩⲧ","span":2},{"text":"الـ – مُكرَّم","span":2}],[{"text":"ⲛ̀-ⲁⲣⲭⲓⲉ̀ⲣⲉⲩⲥ","span":1},{"text":"ἀρχιερεύς","span":2},{"text":"(أداة ربط صفة) – رئيس كهنة","span":1}],[{"text":"ⲡⲁⲡⲁ","span":1},{"text":"πάπας","span":2},{"text":"البابا","span":1}],[{"text":"ⲁⲃⲃⲁ","span":2},{"text":"أبّا","span":2}],[{"text":"(ⲛⲓⲙ)","span":2},{"text":"(الاسم)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲡⲉϥ-ⲕⲉ-ϣ̀ⲫⲏⲣ","span":2},{"text":"ـه – آخر – شريك (شريكه)","span":2}],[{"text":"ⲛ̀-ⲗⲓⲧⲟⲩⲣⲅⲟⲥ","span":1},