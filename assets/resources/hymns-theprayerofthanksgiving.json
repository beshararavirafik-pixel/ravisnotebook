ِعْلِ الشَّيْطَانِ: وَمُؤَامَرَةِ النَّاسِ الْأَشْرَارِ: وَقِيَامِ الْأَعْدَاءِ الْخَفِيِّينَ وَالظَّاهِرِينَ."],"english":["+ Therefore, we ask and entreat Your goodness, O Lover of Mankind: grant us to complete this holy day: and all the days of our life in all peace with Your fear.","+ All envy: all temptation: all the work of Satan: the counsel of wicked men: and the rising up of enemies, hidden and manifest."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉⲑⲃⲉ","span":2},{"text":"من أجل","span":2}],[{"text":"ⲫⲁⲓ","span":2},{"text":"هذا","span":2}],[{"text":"ⲧⲉⲛ-ϯ-ϩⲟ","span":2},{"text":"نحن – نعطي – وجه (نسجد)","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲧⲉⲛ-ⲧⲱⲃϩ","span":2},{"text":"نحن – نتوسل","span":2}],[{"text":"ⲛ̀-ⲧⲉⲕ-ⲙⲉⲧ-ⲁ̀ⲛⲁⲑⲟⲥ","span":1},{"text":"ἀγαθός","span":2},{"text":"الذي لِـ – ـك – حالة – صلاح (صلاحك)","span":1}],[{"text":"Ⲡⲓ-ⲙⲁⲓ-ⲣⲱⲙⲓ","span":2},{"text":"الـ – محب – بشر (يا محب البشر)","span":2}],[{"text":"ⲙⲏⲓⲥ","span":2},{"text":"أعطِ","span":2}],[{"text":"ⲛⲁ-ⲛ","span":2},{"text":"لِـ – ـنا (لنا)","span":2}],[{"text":"ⲉⲑⲣⲉⲛ-ϫⲱⲕ","span":2},{"text":"لِـ نحن – نكمل","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجاً (إلى النهاية)","span":2}],[{"text":"ⲙ̀-ⲡⲁⲓ-ⲕⲉ-ⲉ̀ϩⲟⲟⲩ","span":2},{"text":"الـ – هذا – باقي – يوم (بقية هذا اليوم)","span":2}],[{"text":"ⲉⲑⲟⲩⲁⲃ","span":2},{"text":"المقدس","span":2}],[{"text":"ⲫⲁⲓ","span":2},{"text":"هذا","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲓ-ⲉ̀ϩⲟⲟⲩ","span":2},{"text":"الـ – أيام","span":2}],[{"text":"ⲧⲏⲣ-ⲟⲩ","span":2},{"text":"كل – ـها","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الذي لِـ","span":2}],[{"text":"ⲡⲉⲛ-ⲱⲛϧ","span":2},{"text":"ـنا – حياة (حياتنا)","span":2}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ϩⲓⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲛⲓⲃⲉⲛ","span":2},{"text":"كل","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و، مع","span":2}],[{"text":"ⲧⲉⲕ-ϩⲟϯ","span":2},{"text"