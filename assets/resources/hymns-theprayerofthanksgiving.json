ⲟⲗϩⲁ ⲧⲁⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲑⲁⲓ."],"arabic":["+ وَعَنْ سَائِرِ شَعْبِكَ.","+ وَعَنْ هَذِهِ الْكَنِيسَةِ."],"english":["+ And from all Your people.","+ And from this church."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲑ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ-ϩⲁ","span":2},{"text":"خارجاً – عن (من أجل)","span":2}],[{"text":"ⲡⲉⲕ-ⲗⲁⲟⲥ","span":2},{"text":"ـك – شعب (شعبك)","span":2}],[{"text":"ⲧⲏⲣ-ϥ","span":2},{"text":"كل – ـه","span":2}],[{"text":"✠","span":4}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ-ϩⲁ","span":2},{"text":"خارجاً – عن (من أجل)","span":2}],[{"text":"ⲧⲁⲓ-ⲉⲕⲕⲗⲏⲥⲓⲁ","span":1},{"text":"ἐκκλησία","span":2},{"text":"هذه – كنيسة (هذه الكنيسة)","span":1}],[{"text":"ⲑⲁⲓ","span":2},{"text":"هذه","span":2}]]},{"title":"خاص: وعن موضعك المقدس هذا","role":"priest","verses":{"coptic":["+ ⲛⲉⲙ ⲉ̀ⲃⲟⲗϩⲁ ⲡⲁⲓⲙⲁ ⲉⲑⲟⲩⲁⲃ ⲛ̀ⲧⲁⲕ ⲫⲁⲓ.","+ Ⲛⲏ ⲇⲉ ⲉⲑⲛⲁⲛⲉⲩ ⲛⲉⲙ ⲛⲏⲉ̀ⲧⲉⲣⲛⲟϥⲣⲓ ⲥⲁϩⲛⲓ ⲙ̀ⲙⲱⲟⲩ ⲛⲁⲛ: ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉ ⲉ̀ⲧⲁⲕϯ ⲙ̀ⲡⲓⲉⲣϣⲓϣⲓ ⲛⲁⲛ: ⲉ̀ϩⲱⲙⲓ ⲉ̀ϫⲉⲛ ⲛⲓϩⲟϥ ⲛⲉⲙ ⲛⲓϭⲗⲏ: ⲛⲉⲙ ⲉ̀ϫⲉⲛ ϯϫⲟⲙ ⲧⲏⲣⲥ ⲛ̀ⲧⲉ ⲡⲓϫⲁϫⲓ."],"arabic":["+ وَعَنْ مَوْضِعِكَ الْمُقَدَّسِ هَذَا.","+ أَمَّا اَلصَّالِحَاتُ وَالنَّافِعَاتُ فَارْزُقْنَا إِيَّاهَا: لِأَنَّكَ أَنْتَ اَلَّذِي أَعْطَيْتَنَا اَلسُّلْطَانَ: أَنْ نَدُوسَ عَلَى اَلْحَيَّاتِ وَالْعَقَارِبِ: وَكُلَّ قُوَّةِ اَلْعَدُوِّ."],"english":["+ And from this, Your holy place.","+ But those things which are good and profitable do provide for us: for it is You Who have given us the authority: to tread on serpents and scorpions: and upon all the power of the enemy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ-ϩⲁ","span":2},{"text":"خارجاً – عن (من أجل)","span":2}],[{"text":"ⲡⲁⲓ-ⲙⲁ","span":2},{"text":"هذا – مكان (هذا المكان)","span":2}],[{"text":"ⲉⲑⲟⲩⲁⲃ","span":2},{"text":"المقدس","span":2}],[{"text":"ⲛ̀ⲧⲁⲕ","span":2},{"text":"الذي لِـ ـك (الذي لك)","span":2}],[{"text":"ⲫⲁⲓ","span":2},{"text":"هذا","span":2}],[{"text":"✠","span":4}],[{"text":"Ⲛⲏ","span":2},{"text":"تلك، أولئك","span":2}],[{"text":"ⲇⲉ","span":1},{"text":"δέ","span":2},{"text":"أما، و (عاطف)","span":1}],[{"text":"ⲉⲑ-ⲛⲁⲛⲉⲩ","span":2},{"text":"التي – صالحة (الصالحات)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲏ-ⲉ̀ⲧⲉⲣ-ⲛⲟϕⲣⲓ","span":2},{"text":"تلك – التي – تصنع – نفع (النافعات)","span":2}],[{"text":"ⲥⲁϩⲛⲓ","span":2},{"text":"اكتب، حدد","span":2}],[{"text":"ⲙ̀ⲙⲱ-ⲟⲩ","span":2},{"text":"إلى – ـها (إياها)","span":2}],[{"text":"ⲛⲁ-ⲛ","span":2},{"text":"لِـ – ـنا (لنا)","span":2}],[{"text":"ϫⲉ","span":2},{"text":"لأن","span":2}],[{"text":"ⲛ̀ⲑⲟⲕ","span":2},{"text":"أنت","span":2}],[{"text":"ⲡⲉ","span":2},{"text":"هو (الربط)","span":2}],[{"text":"ⲉ̀ⲧ-ⲁⲕ-ϯ","span":2},{"text":"الذي – أنت قد – أعطيت","span":2}],[{"text":"ⲙ̀-ⲡⲓ-ⲉⲣϣⲓϣⲓ","span":2},{"text":"الـ – الـ – سلطان","span":2}],[{"text":"ⲛⲁ-ⲛ","span":2},{"text":"لِـ – ـنا (لنا)","span":2}],[{"text":"ⲉ̀-ϩⲱⲙⲓ","span":2},{"text":"أن – ندوس","span":2}],[{"text":"ⲉ̀ϫⲉⲛ","span":2},{"text":"على","span":2}],[{"text":"ⲛⲓ-ϩⲟϥ","span":2},{"text":"الـ – حيات","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲓ-ϭⲗⲏ","span":2},{"text":"الـ – عقارب","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲉ̀ϫⲉⲛ","span":2},{"text":"على","span":2}],[{"text":"Ϯ-ϫⲟⲙ","span":2},{"text":"الـ – قوة","span":2}],[{"text":"ⲧⲏⲣ-ⲥ","span":2},{"text":"كل – ـها","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الذي لِـ","span":2}],[{"text":"ⲡⲓ-ϫⲁϫⲓ","span":2},{"text":"الـ – عدو","span":2}]]},{"title":"خاص: ولا تدخلنا في تجربة","role":"priest","verses":{"coptic":["+ Ⲟⲩⲟϩ ⲙ̀ⲡⲉⲣⲉⲛⲧⲉⲛ ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲓⲣⲁⲥⲙⲟⲥ: ⲁⲗⲗⲁ ⲛⲁϩⲙⲉⲛ ⲉ̀ⲃⲟⲗ ϩⲁ ⲡⲓⲡⲉⲧϩⲱⲟⲩ.","+ Ϧⲉⲛ ⲡⲓϩ̀ⲙⲟⲧ ⲛⲉⲙ ⲛⲓⲙⲉⲧϣⲉⲛϩⲏⲧ ⲛⲉⲙ ϯⲙⲉⲧⲙⲁⲓⲣⲱⲙⲓ ⲛ̀ⲧⲉ ⲡⲉⲕⲙⲟⲛⲟⲅⲉⲛⲏⲥ ⲛ̀Ϣⲏⲣⲓ: Ⲡⲉⲛϭⲟⲓⲥ ⲟⲩⲟϩ Ⲡⲉⲛⲛⲟⲩϯ ⲟⲩⲟϩ Ⲡⲉⲛⲥⲱⲧⲏⲣ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ.","+ Ⲫⲁⲓ ⲉ̀ⲧⲉ ⲉ̀ⲃⲟⲗ ϩⲓⲧⲟⲧϥ ⲉ̀ⲣⲉ ⲡⲓⲱ̀ⲟⲩ ⲛⲉⲙ ⲡⲓⲧⲁⲓⲟ ⲛⲉⲙ ⲡⲓⲁ̀ⲙⲁϩⲓ ⲛⲉⲙ ϯⲡ̀ⲣⲟⲥⲕⲩⲛⲏⲥⲓⲥ: ⲉⲣⲡ̀ⲣⲉⲡⲓ ⲛⲁⲕ ⲛⲉⲙⲁϥ ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ ⲛ̀ⲣⲉϥⲧⲁⲛϧⲟ ⲟⲩⲟϩ ⲛ̀ⲟ̀ⲙⲟⲟⲩⲥⲓⲟⲥ ⲛⲉⲙⲁⲕ.","+ Ϯⲛⲟⲩ ⲛⲉⲙ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ ⲛⲉⲙ ϣⲁ ⲉ̀ⲛⲉϩ ⲛ̀ⲧⲉ ⲛⲓⲉ̀ⲛⲉϩ ⲧⲏⲣⲟⲩ: ⲁ̀ⲙⲏⲛ."],"arabic":["+ وَلَا تُدْخِلْنَا فِي تَجْرِبَةٍ: لَكِنْ نَجِّنَا مِنَ الشِّرِّيرِ.","+ بِالنِّعْمَةِ وَالرَّأْفَاتِ وَمَحَبَّةِ الْبَشَرِ اللَّوَاتِي لِابْنِكَ الْوَحِيدِ: رَبِّنَا وَإِلَهِنَا وَمُخَلِّصِنَا يَسُوعَ الْمَسِيحِ.","+ هَذَا الَّذِي مِنْ قِبَلِهِ الْمَجْدُ وَالإِكْرَامُ وَالْعِزَّةُ وَالسُّجُودُ: تَلِيقُ بِكَ مَعَهُ مَعَ الرُّوحِ الْقُدُسِ الْمُحْيِي الْمُسَاوِي لَكَ.","+ اَلْآنَ وَكُلَّ أَوَانٍ وَإِلَى دَهْرِ الدُّهُورِ. آمِينَ."],"english":["+ And lead us not into temptation: but deliver us from the evil one.","+ Through the grace, compassion, and love of mankind of Your Only-Begotten Son: our Lord, God, and Savior, Jesus Christ.","+ Through Whom the glory, the honor, the dominion, and the adoration: are due unto You, with Him and the Holy Spirit, the Life-Giver, Who is of one essence with You.","+ Now and at all times and unto the age of all ages. Amen."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲙ̀ⲡⲉⲣ-ⲉⲛⲧⲉⲛ","span":2},{"text":"لا – تدخلنا (لا تدخلنا)","span":2}],[{"text":"ⲉ̀ϧⲟⲩⲛ","span":2},{"text":"إلى الداخل","span":2}],[{"text":"ⲉ̀-ⲡⲓ-ⲣⲁⲥⲙⲟⲥ","span":1},{"text":"πειρασμός","span":2},{"text":"إلى – الـ – تجربة (في تجربة)","span":1}],[{"text":"ⲁⲗⲗⲁ","span":1},{"text":"ἀλλά","span":2},{"text":"بل","span":1}],[{"text":"ⲛⲁϩⲙⲉⲛ","span":2},{"text":"نجنا","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجا","span":2}],[{"text":"ϩⲁ","span":2},{"text":"من","span":2}],[{"text":"ⲡⲓ-ⲡⲉⲧ-ϩⲱⲟⲩ","span":2},{"text":"الـ – الذي – شرير (الشرير)","span":2}],[{"text":"✠","span":4}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ⲡⲓ-ϩ̀ⲙⲟⲧ","span":1},{"text":"χάρις","span":2},{"text":"الـ – نعمة","span":1}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲛⲓ-ⲙⲉⲧ-ϣⲉⲛϩⲏⲧ","span":2},{"text":"الـ – (مقطع معنى) – طول – بال (طول الأناة)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ϯ-ⲙⲉⲧ-ⲙⲁⲓ-ⲣⲱⲙⲓ","span":2},{"text":"الـ – (مقطع معنى) – محب – إنسان (محبة البشر)