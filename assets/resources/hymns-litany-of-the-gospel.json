{"id":"hymns-litany-of-the-gospel","units":[{"title":"صلِ","role":"priest","verses":{"coptic":["+ Ϣ̀ⲗⲏⲗ."],"arabic":["+ صَلِّ."],"english":["+ Pray."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣ̀ⲗⲏⲗ","span":2},{"text":"صَلِّ (صيغة أمر)","span":2}]]},{"title":"للصلاة قفوا","role":"deacon","verses":{"coptic":["+ Ⲉ̀ⲡⲓ ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ ⲥ̀ⲧⲁⲑⲏⲧⲉ."],"arabic":["+ لِلصَّلَاةِ قِفُوا."],"english":["+ Stand up for prayer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀ⲡⲓ","span":1},{"text":"ἐπί","span":2},{"text":"لأجل، لغرض","span":1}],[{"text":"ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ","span":1},{"text":"προσευχή","span":2},{"text":"الصلاة (πρός (نحو، إلى) + εὐχή (صلاة، طلب) = προσευχή (الصلاة الموجهة نحو الله))","span":1}],[{"text":"ⲥ̀ⲧⲁⲑⲏⲧⲉ","span":1},{"text":"στάθητε","span":2},{"text":"قفوا، قوموا","span":1}],[{"text":"✠","span":4}]]},{"title":"السلام للكل","role":"priest","verses":{"coptic":["+ Ⲓ̀ⲣⲏⲛⲏ ⲡⲁⲥⲓ."],"arabic":["+ اَلسَّلَامُ لِلْكُلِّ."],"english":["+ Peace be to all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲓ̀ⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲡⲁⲥⲓ","span":1},{"text":"πᾶσι","span":2},{"text":"للجميع (صيغة الجمع غير المباشر لـ πᾶς)","span":1}],[{"text":"✠","span":4}]]},{"title":"ولروحك","role":"people","verses":{"coptic":["+ Ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ."],"arabic":["+ وَلِرُوحِكَ."],"english":["+ And to Your Spirit."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲧⲱ","span":1},{"text":"τῷ","span":2},{"text":"مع الـ","span":1}],[{"text":"ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ","span":1},{"text":"πνεύματι","span":2},{"text":"روح","span":1}],[{"text":"ⲥⲟⲩ","span":1},{"text":"σου","span":2},{"text":"التي لك (روحك)","span":1}],[{"text":"✠","span":4}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲫ̀ⲛⲏⲃ Ⲡ̀ϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲛⲟⲩϯ: ⲫⲏⲉ̀ⲧⲁϥϫⲟⲥ ⲛ̀ⲛⲉϥⲁ̀ⲅⲓⲟⲥ ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲙ̀ⲙⲁⲑⲏⲧⲏⲥ ⲟⲩⲟϩ ⲛ̀ⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲉⲑⲟⲩⲁⲃ.","+ Ϫⲉ ϩⲁⲛⲙⲏϣ ⲙ̀ⲡ̀ⲣⲟⲫⲏⲧⲏⲥ ⲛⲉⲙ ϩⲁⲛⲑ̀ⲙⲏⲓ ⲁⲩⲉⲣⲉ̀ⲡⲓⲑⲩⲙⲓⲛ ⲉ̀ⲛⲁⲩ ⲉ̀ⲛⲏⲉ̀ⲧⲉⲧⲉⲛⲛⲁⲩ ⲉ̀ⲣⲱⲟⲩ ⲟⲩⲟϩ ⲙ̀ⲡⲟⲩⲛⲁⲩ: ⲟⲩⲟϩ ⲉ̀ⲥⲱⲧⲉⲙ ⲉ̀ⲛⲏⲉ̀ⲧⲉⲧⲉⲛⲥⲱⲧⲉⲙ ⲉ̀ⲣⲱⲟⲩ ⲟⲩⲟϩ ⲙ̀ⲡⲟⲩⲥⲱⲧⲉⲙ. Ⲛ̀ⲑⲱⲧⲉⲛ ⲇⲉ ⲱ̀ⲟⲩⲛⲓⲁⲧⲟⲩ ⲛ̀ⲛⲉⲧⲉⲛⲃⲁⲗ ϫⲉ ⲥⲉⲛⲁⲩ: ⲛⲉⲙ ⲛⲉⲧⲉⲛⲙⲁϣϫ ϫⲉ ⲥⲉⲥⲱⲧⲉⲙ.","+ Ⲙⲁⲣⲉⲛⲉⲣⲡ̀ⲉⲙⲡ̀ϣⲁ ⲛ̀ⲥⲱⲧⲉⲙ ⲟⲩⲟϩ ⲉ̀ⲓ̀ⲣⲓ ⲛ̀ⲛⲉⲕⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲉⲑⲟⲩⲁⲃ ϧⲉⲛ ⲛⲓⲧⲱⲃϩ ⲛ̀ⲧⲉ ⲛⲏⲉⲑⲟⲩⲁⲃ ⲛ̀ⲧⲁⲕ."],"arabic":["+ أَيُّهَا اَلسَّيِّدُ اَلرَّبُّ يَسُوعُ اَلْمَسِيحُ إِلَهُنَا: اَلَّذِي قَالَ لِتَلَامِيذِهِ اَلْقِدِّيسِينَ وَرُسُلِهِ اَلْأَطْهَارِ اَلْمُكَرَّمِينَ.","+ “إِنَّ أَنْبِيَاءَ وَأَبْرَارًا كَثِيرِينَ اِشْتَهَوْا أَنْ يَرَوْا مَا أَنْتُمْ تَرَوْنَ وَلَمْ يَرَوْا: وَأَنْ يَسْمَعُوا مَا أَنْتُمْ تَسْمَعُونَ وَلَمْ يَسْمَعُوا: أَمَّا أَنْتُمْ فَطُوبَى لِأَعْيُنِكُمْ لِأَنَّهَا تُبْصِرُ: وَلِآذَانِكُمْ لِأَنَّهَا تَسْمَعُ.”","+ فَلْنَسْتَحِقَّ أَنْ نَسْمَعَ وَنَعْمَلَ بِأَنَاجِيلِكَ اَلْمُقَدَّسَةِ بِطَلَبَاتِ قِدِّيسِيكَ."],"english":["+ O Master Lord Jesus Christ our God: Who said to His holy disciples and His pure honored apostles.","+ “Truly many prophets and righteous men desired to see what you see and did not see: and to hear what you hear and did not hear: but as for you blessed are your eyes because they behold: and your ears because they hear.”","+ May we be worthy to hear and to act upon Your holy Gospels through the intercessions of Your saints."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲫ̀-ⲛⲏⲃ","span":2},{"text":"الـ – سيد (سيدنا)","span":2}],[{"text":"Ⲡ̀-ϭⲟⲓⲥ","span":2},{"text":"الـ – رب","span":2}],[{"text":"Ⲓⲏⲥⲟⲩⲥ","span":1},{"text":"Ἰησοῦς","span":2},{"text":"يسوع","span":1}],[{"text":"Ⲡⲓ-ⲭ̀ⲣⲓⲥⲧⲟⲥ","span":1},{"text":"Χριστός","span":2},{"text":"الـ – مسيح","span":1}],[{"text":"Ⲡⲉⲛ-ⲛⲟⲩϯ","span":2},{"text":"ـنا – إله (إلهنا)","span":2}],[{"text":"ⲫⲏ-ⲉ̀ⲧⲁϥ-ϫⲟ-ⲥ","span":2},{"text":"ذاك – الذي هو قد – قال – ـها (الذي قالها)","span":2}],[{"text":"ⲛ̀-ⲛⲉϥ-ⲁ̀ⲅⲓⲟⲥ","span":2},{"text":"(أداة ربط للإضافة) – ـه – قديسين (لقديسيه)","span":2}],[{"text":"ⲉⲧ-ⲧⲁⲓⲏⲟⲩⲧ","span":2},{"text":"الذين – مكرمين (المكرمين)","spa