["+ يَا رَبُّ ارْحَمْ."],"english":["+ Lord have mercy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲩⲣⲓⲉ","span":1},{"text":"κύριε","span":2},{"text":"يا رب","span":1}],[{"text":"ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ","span":1},{"text":"ἐλέησον","span":2},{"text":"ارحم","span":1}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲁ̀ⲣⲓⲫ̀ⲙⲉⲩⲓ ⲇⲉ ⲟⲛ Ⲡⲉⲛⲛⲏⲃ ⲛ̀ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ ⲉ̀ⲧⲁⲩϩⲟⲛϩⲉⲛ ⲛⲁⲛ ⲉ̀ⲉⲣⲡⲟⲩⲙⲉⲩⲓ ϧⲉⲛ ⲛⲉⲛϯϩⲟ ⲛⲉⲙ ⲛⲉⲛⲧⲱⲃϩ ⲉ̀ⲧⲉⲛⲓ̀ⲣⲓ ⲙ̀ⲙⲱⲟⲩ ⲉ̀ⲡ̀ϣⲱⲓ ϩⲁⲣⲟⲕ Ⲡ̀ϭⲟⲓⲥ Ⲡⲉⲛⲛⲟⲩϯ. Ⲛⲏⲉ̀ⲧⲁⲩⲉⲣϣⲟⲣⲡ ⲛ̀ⲉⲛⲕⲟⲧ ⲙⲁⲙ̀ⲧⲟⲛ ⲛⲱⲟⲩ. Ⲛⲏⲉⲧϣⲱⲛⲓ ⲙⲁⲧⲁⲗϭⲱⲟⲩ.","+ Ϫⲉ ⲛ̀ⲑⲟⲕ ⲅⲁⲣ ⲡⲉ ⲡⲉⲛⲱⲛϧ ⲧⲏⲣⲟⲩ: ⲛⲉⲙ ⲡⲉⲛⲟⲩϫⲁⲓ ⲧⲏⲣⲟⲩ: ⲛⲉⲙ ⲧⲉⲛϩⲉⲗⲡⲓⲥ ⲧⲏⲣⲟⲩ: ⲛⲉⲙ ⲡⲉⲛⲧⲁⲗϭⲟ ⲧⲏⲣⲟⲩ: ⲛⲉⲙ ⲧⲉⲛⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ ⲧⲏⲣⲉⲛ."],"arabic":["+ اُذْكُرْ أَيْضاً يَا سَيِّدَنَا كُلَّ اَلَّذِينَ أَوْصَوْنَا أَنْ نَذْكُرَهُمْ فِي تَضَرُّعَاتِنَا وَطَلَبَاتِنَا اَلَّتِي نُصْعِدُهَا إِلَيْكَ أَيُّهَا اَلرَّبُّ إِلَهُنَا: اَلَّذِينَ سَبَقُوا فَرَقَدُوا نَيِّحْهُمْ: اَلْمَرْضَى اِشْفِهِمْ.","+ لِأَنَّكَ أَنْتَ حَيَاتُنَا كُلُّنَا: وَخَلَاصُنَا كُلُّنَا: وَرَجَاؤُنَا كُلُّنَا: وَشِفَاؤُنَا كُلُّنَا: وَقِيَامَتُنَا كُلُّنَا."],"english":["+ Remember also O our Master all those who have asked us to remember them in our supplications and our petitions which we offer up unto You O Lord our God: those who have fallen asleep before us grant them rest: heal the sick.","+ For You are the life of us all: and the salvation of us all: and the hope of us all: and the healing of us all: and the resurrection of us all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲁ̀ⲣⲓ-ⲫ̀-ⲙⲉⲩⲓ","span":2},{"text":"اصنع – الـ – ذكر (اذكر)","span":2}],[{"text":"ⲇⲉ","span":1},{"text":"δέ","span":2},{"text":"أيضاً","span":1}],[{"text":"ⲟⲛ","span":2},{"text":"أيضاً","span":2}],[{"text":"Ⲡⲉⲛ-ⲛⲏⲃ","span":2},{"text":"ـنا – سيد (سيدنا)","span":2}],[{"text":"ⲛ̀-ⲟⲩⲟⲛ","span":2},{"text":"(أداة ربط للإضافة) – شخص (الكل)","span":2}],[{"text":"ⲛⲓⲃⲉⲛ","span":2},{"text":"كل","span":2}],[{"text":"ⲉ̀ⲧⲁⲩ-ϩⲟⲛϩⲉⲛ","span":2},{"text":"الذين هم قد – أوصوا","span":2}],[{"text":"ⲛⲁⲛ","s