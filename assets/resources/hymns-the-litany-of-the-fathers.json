ِ: وَأَخَوَيْهِ اَلرُّوحِيَّيْنِ فِي اَلْخِدْمَةِ اَلرَّسُولِيَّةِ مَارِ أَغْنَاطِيُوسَ (…) بَطْرِيَرْكِ أَنْطَاكِيَةَ: وَأَبُونَا (…) بَطْرِيَرْكِ أَرِيتِيرِيَا."],"english":["+ Pray for our high priest Pope Anba (…) Pope and Patriarch and Archbishop of the great city of Alexandria: and his two spiritual brothers in the apostolic ministry Mar Ignatius (…) Patriarch of Antioch: and our father (…) Patriarch of Eritrea."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲡⲣⲟⲥⲉⲩⲝⲁⲥⲑⲉ","span":1},{"text":"προσεύχεσθε","span":2},{"text":"صلوا","span":1}],[{"text":"ⲩ̀ⲡⲉⲣ","span":1},{"text":"ὑπέρ","span":2},{"text":"عن (من أجل)","span":1}],[{"text":"ⲧⲟⲩ","span":1},{"text":"τοῦ","span":2},{"text":"(أداة تعريف)","span":1}],[{"text":"ⲁⲣⲭⲓⲉ̀ⲣⲉⲱⲥ","span":1},{"text":"ἀρχιερέως","span":2},{"text":"رئيس – كهنة (رئيس الكهنة)","span":1}],[{"text":"ⲏ̀ⲙⲱⲛ","span":1},{"text":"ἡμῶν","span":2},{"text":"ـنا","span":1}],[{"text":"ⲡⲁⲡⲁ","span":1},{"text":"πάπα","span":2},{"text":"بابا","span":1}],[{"text":"ⲁⲃⲃⲁ","span":1},{"text":"ἀββᾶ / אַבָּא","span":2},{"text":"أب","span":1}],[{"text":"(ⲛⲓⲙ)","span":2},{"text":"(اسم)","span":2}],[{"text":"ⲡⲁⲡⲁ","span":1},{"text":"πάπα","span":2},{"text":"بابا","span":1}],[{"text":"ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲡⲁⲧⲣⲓⲁⲣⲭⲟⲩ","span":1},{"text":"πατριάρχου","span":2},{"text":"بطريرك","span":1}],[{"text":"ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲁⲣⲭⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲩ","span":1},{"text":"ἀρχιεπισκόπου","span":2},{"text":"رئيس – أساقفة (رئيس الأساقفة)","span":1}],[{"text":"ⲧⲏⲥ","span":1},{"text":"τῆς","span":2},{"text":"(أداة تعريف)","span":1}],[{"text":"ⲙⲉⲅⲁⲗⲟⲩ","span":1},{"text":"μεγάλης","span":2},{"text":"عظيمة","span":1}],[{"text":"ⲡⲟⲗⲉⲱⲥ","span":1},{"text":"πόλεως","span":2},{"text":"مدينة","span":1}],[{"text":"Ⲁⲗⲉⲝⲁⲛⲇ̀ⲣⲓⲁⲥ","span":1},{"text":"Ἀλεξανδρείας","span":2},{"text":"الإسكندرية","span":1}],[{"text":"ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"te