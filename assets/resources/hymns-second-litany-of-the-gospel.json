{"id":"hymns-second-litany-of-the-gospel","units":[{"title":"صلِ","role":"priest","verses":{"coptic":["+ Ϣ̀ⲗⲏⲗ."],"arabic":["+ صَلِّ."],"arabized":["+ أشليل."],"english":["+ Pray."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣ̀ⲗⲏⲗ","span":2},{"text":"صَلِّ (صيغة أمر)","span":2}]]},{"title":"للصلاة قفوا","role":"deacon","verses":{"coptic":["+ Ⲉ̀ⲡⲓ ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ ⲥ̀ⲧⲁⲑⲏⲧⲉ."],"arabic":["+ لِلصَّلَاةِ قِفُوا."],"arabized":["+ إى بي أبروس أفشي أسطاثيتى."],"english":["+ Stand up for prayer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀ⲡⲓ","span":1},{"text":"ἐπί","span":2},{"text":"لأجل، لغرض","span":1}],[{"text":"ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ","span":1},{"text":"προσευχή","span":2},{"text":"الصلاة (πρός (نحو، إلى) + εὐχή (صلاة، طلب) = προσευχή (الصلاة الموجهة نحو الله))","span":1}],[{"text":"ⲥ̀ⲧⲁⲑⲏⲧⲉ","span":1},{"text":"στάθητε","span":2},{"text":"قفوا، قوموا","span":1}],[{"text":"✠","span":4}]]},{"title":"السلام للكل","role":"priest","verses":{"coptic":["+ Ⲓ̀ⲣⲏⲛⲏ ⲡⲁⲥⲓ."],"arabic":["+ اَلسَّلَامُ لِلْكُلِّ."],"arabized":["+ إيريني باسي."],"english":["+ Peace be to all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲓ̀ⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲡⲁⲥⲓ","span":1},{"text":"πᾶσι","span":2},{"text":"للجميع (صيغة الجمع غير المباشر لـ πᾶς)","span":1}],[{"text":"✠","span":4}]]},{"title":"ولروحك","role":"people","verses":{"coptic":["+ Ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ."],"arabic":["+ وَلِرُوحِكَ."],"arabized":["+ كيه طو بنيفماتي سو."],"english":["+ And to Your Spirit."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲧⲱ","span":1},{"text":"τῷ","span":2},{"text":"مع الـ","span":1}],[{"text":"ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ","span":1},{"text":"πνεύματι","span":2},{"text":"روح","span":1}],[{"text":"ⲥⲟⲩ","span":1},{"text":"σου","span":2},{"text":"التي لك (روحك)","span":1}],[{"text":"✠","span":4}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲫ̀ⲛⲏⲃ Ⲡ̀ϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲛⲟⲩϯ: ⲫⲏⲉ̀ⲧⲁϥⲟⲩⲱⲣⲡ ⲛ̀ⲛⲉϥⲁ̀ⲅⲓⲟⲥ ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲙ̀ⲙⲁⲑⲏⲧⲏⲥ ⲟⲩⲟϩ ⲛ̀ⲁⲡⲟⲥⲧⲟⲗⲟⲥ ⲉⲑⲟⲩⲁⲃ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲕⲟⲥⲙⲟⲥ ⲧⲏⲣϥ.","+ Ⲉ̀ϩⲓⲱⲓϣ ⲙ̀ⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ ⲛ̀ⲧⲉ ⲧⲉⲕⲙⲉⲧⲟⲩⲣⲟ: ⲛⲉⲙ ⲉ̀ϯⲥ̀ⲃⲱ ⲛ̀ⲛⲓⲉⲑⲛⲟⲥ ⲧⲏⲣⲟⲩ: ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲡⲉⲕⲉ̀ⲙⲓ ⲙ̀ⲙⲏⲓ.","+ Ⲧⲉⲛϯϩⲟ ⲉ̀ⲣⲟⲕ Ⲡⲉⲛⲛⲏⲃ ⲁ̀ⲟⲩⲱⲛ ⲛ̀ⲛⲓⲙⲁϣϫ ⲛ̀ⲧⲉ ⲛⲉⲛϩⲏⲧ: ⲉ̀ⲡ̀ϫⲓⲛⲥⲱⲧⲉⲙ ⲉ̀ⲛⲉⲕⲉⲩⲁⲅⲅⲉⲗⲓⲟⲩ."],"arabic":["+ أَيُّهَا اَلسَّيِّدُ اَلرَّبُّ يَسُوعُ اَلْمَسِيحُ إِلَهُنَا: اَلَّذِي أَرْسَلَ تَلَامِيذَهُ اَلْقِدِّيسِينَ اَلْمُكَرَّمِينَ: وَرُسُلَهُ اَلْأَطْهَارَ فِي اَلْعَالَمِ كُلِّهِ.","+ لِيَكْرِزُوا بِإِنْجِيلِ مَلَكُوتِكَ: وَيُعَلِّمُوا كُلَّ اَلْأُمَمِ مَعْرِفَتَكَ اَلْحَقِيقِيَّةَ.","+ نَسْأَلُكَ يَا سَيِّدَنَا: اِفْتَحْ آذَانَ قُلُوبِنَا لِكَيْ نَسْمَعَ أَنَاجِيلَكَ اَلْمُقَدَّسَةَ."],"arabized":["+ إفنوتى إپتشويس إيسوس پيخريستوس پين نوتى: في إطاف أوؤورپ إن نيف أجيو إتطايووت إم ماثيتيس أوه إن أبوستولوس إثؤواب إيڤول خين پيكوسموس تيرف.","+ إيهيؤويش إمپي إيوانجيليون إنتى تيك ميت أورو: نيم إيتى إسبو إن ني إثنوس تيرو: إيخون إي پيك إيمى إممى.","+ تين تي هو إيروك خين نيب آ أوؤون إن ني ماشچ إنتى نين هيت: إي پچين سوتيم إي نيك إيوانجيليون."],"english":["+ O Master Lord Jesus Christ our God: Who sent His holy honored disciples: and His pure apostles throughout the whole world.","+ That they may preach the Gospel of Your Kingdom: and teach all nations Your true knowledge.","+ We ask You O our Master: open the ears of our hearts that we may hear Your holy Gospels."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲫ̀-ⲛⲏⲃ","span":2},{"text":"الـ – سيد (السيد)","span":2}],[{"text":"Ⲡ̀-ϭⲟⲓⲥ","span":2},{"text":"الـ – رب (الرب)","span":2}],[{"text":"Ⲓⲏⲥⲟⲩⲥ","span":1},{"text":"Ἰησοῦς / יֵשׁוּעַ","span":2},{"text":"يسوع","span":1}],[{"text":"Ⲡⲓ-ⲭ̀ⲣⲓⲥⲧⲟⲥ","span":1},{"text":"Χριστός","span":2},{"text":"الـ – مسيح (المسيح)","span":1}],[{"text":"Ⲡⲉⲛ-ⲛⲟⲩϯ","span":2},{"text":"ـنا – إله (إلهنا)","span":2}],[{"text":"ⲫⲏ-ⲉ̀ⲧⲁϥ-ⲟⲩⲱⲣⲡ","span":2},{"text":"ذاك – الذي – هو قد – أرسل (الذي أرسل)","span":2}],[{"text":"ⲛ̀-ⲛⲉϥ-ⲁ̀ⲅⲓⲟⲥ","span":2},{"text":"(أداة ربط للإضافة) – ـه – قديسين (قديسيه)","span":2}],[{"text":"ⲉⲧ-ⲧⲁⲓⲏⲟⲩⲧ","span":2},{"text":"الذين – مكرمين (المكرمين)","span":2}],[{"text":"ⲙ̀-ⲙⲁⲑⲏⲧⲏⲥ","span":1},{"text":"μαθητής","span":2},{"text":"(أداة ربط للإضافة) – تلاميذ (تلاميذ)","span":1}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲛ̀-ⲁⲡⲟⲥⲧⲟⲗⲟⲥ","span":1},{"text":"ἀπόστολος","span":2},{"text":"(أداة ربط للإضافة) – رسل (رسل)","span":1}],[{"text":"ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"الذين – مقدسين (القديسين)","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"خارجا (إلى)","span":2}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"ⲡⲓ-ⲕⲟⲥⲙⲟⲥ","span":1},{"text":"κόσμος","span":2},{"text":"الـ – عالم (العالم)","span":1}],[{"text":"ⲧⲏⲣ-ϥ","span":2},{"text":"كل – ـه (كله)","span":2}],[{"text":"✠","span":4}],[{"text":"Ⲉ̀-ϩⲓⲱⲓϣ","span":2},{"text":"لـ – كرازة (لكي يكرزوا)","span":2}],[{"text":"ⲙ̀-ⲡⲓ-ⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ","span":1},{"text":"εὐαγγέλιον","span":2},{"text":"(أداة ربط للإضافة) – الـ – إنجيل (بالإنجيل)","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الخاص بـ","span":2}],[{"text":"ⲧⲉⲕ-ⲙⲉⲧ-ⲟⲩⲣⲟ","span":2},{"text":"ـك – (مقطع المعنى) – ملك (ملكوتك)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"مع","span":2}],[{"text":"ⲉ̀-ϯ-ⲥ̀ⲃⲱ","span":2},{"text":"لـ – إعطاء – تعليم (وتعليم)","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ⲉⲑⲛⲟⲥ","span":2},{"text":"(أداة ربط للإضافة) – الـ – أمم (الأمم)","span":2}],[{"text":"ⲧⲏⲣ-ⲟⲩ","span":2},{"text":"كل – ـهم (كلهم)","span":2}],[{"text":"ⲉ̀ϧⲟⲩⲛ","span":2},{"text":"إلى الداخل","span":2}],[{"text":"ⲉ̀-ⲡⲉⲕ-ⲉ̀ⲙⲓ","span":2},{"text":"إلى – ـك – معرفة (لمعرفتك)","span":2}],[{"text":"ⲙ̀-ⲙⲏⲓ","span":2},{"text":"(أداة ربط للإضافة) – حق (الحقيقية)","span":2}],[{"text":"✠","span":4}],[{"text":"Ⲧⲉⲛ-ϯ-ϩⲟ","span":2},{"text":"نحن – نعطي – وجه (نطلب)","span":2}],[{"text":"ⲉ̀ⲣⲟ-ⲕ","span":2},{"text":"إليك","span":2}],[{"text":"Ⲡⲉⲛ-ⲛⲏⲃ","span":2},{"text":"ـنا – سيد (سيدنا)","span":2}],[{"text":"ⲁ̀-ⲟⲩⲱⲛ","span":2},{"text":"قد – افتح (افتح)","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ⲙⲁϣϫ","span":2},{"text":"(أداة ربط للإضافة) – الـ – آذان (آذان)","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الخاص بـ","span":2}],[{"text":"ⲛⲉⲛ-ϩⲏⲧ","span":2},{"text":"ـنا – قلوب (قلوبنا)","span":2}],[{"text":"ⲉ̀-ⲡ̀-ϫⲓⲛ-ⲥⲱⲧⲉⲙ","span":2},{"text":"لـ – الـ – فعل – سماع (لسماع)","span":2}],[{"text":"ⲉ̀-ⲛⲉⲕ-ⲉⲩⲁⲅⲅⲉⲗⲓⲟⲩ","span":2},{"text":"لـ – ـك – إنجيل (إنجيلك)","span":2}]]},{"title":"صلوا من أجل الإنجيل المقدس","role":"deacon","verses":{"coptic":["+ Ⲡ̀ⲣⲟⲥⲉⲩⲝⲁⲥⲑⲉ ⲩ̀ⲡⲉⲣ ⲧⲟⲩ ⲁ̀ⲅⲓⲟⲩ ⲉⲩⲁⲅⲅⲉⲗⲓⲟⲩ."],"arabic":["+ صَلُّوا مِنْ أَجْلِ اَلْإِنْجِيلِ اَلْمُقَدَّسِ."],"arabized":["+ إپروسيفكساستى إيپير تو أجيو إيڤانجيليون."],"english":["+ Pray for the Holy Gospel."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲡ̀ⲣⲟⲥⲉⲩⲝⲁⲥⲑⲉ","span":1},{"text":"προσεύχεσθε","span":2},{"text":"صلوا","span":1}],[{"text":"ⲩ̀ⲡⲉⲣ","span":1},{"text":"ὑπέρ","span":2},{"text":"من أجل","span":1}],[{"text":"ⲧⲟⲩ","span":1},{"text":"τοῦ","span":2},{"text":"الـ","span":1}],[{"text":"ⲁ̀ⲅⲓⲟⲩ","span":1},{"text":"ἁγίου","span":2},{"text":"مقدس","span":1}],[{"text":"ⲉⲩⲁⲅⲅⲉⲗⲓⲟⲩ","span":1},{"text":"εὐαγγελίου","span":2},{"text":"إنجيل","span":1}]]},{"title":"يا رب ارحم","role":"people","verses":{"coptic":["+ Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ."],"arabic":["+ يَا رَبُّ ارْحَمْ."],"arabized":["+ كيريه اليسون."],"english":["+ Lord have mercy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲩⲣⲓⲉ","span":1},{"text":"κύριε","span":2},{"text":"يا رب","span":1}],[{"text":"ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ","span":1},{"text":"ἐλέησον","span":2},{"text":"ارحم","span":1}]]},{"title":"فقرة مخصصة","role":"priest","verses":{"coptic":["+ Ⲟⲩⲟϩ ⲁ̀ⲟⲩⲱⲛ ⲛ̀ⲛⲓⲉⲥⲑⲏⲧⲏⲣⲓⲟⲛ ⲛ̀ⲧⲉ ⲛⲉⲛⲯⲏⲭⲏ: ⲟⲩⲟϩ ⲙⲁⲣⲓⲛⲉⲣⲡ̀ⲉⲙⲡ̀ϣⲁ ⲛ̀ϣⲱⲡⲓ ⲟⲩⲙⲟⲛⲟⲛ ⲛ̀ⲣⲉϥⲥⲱⲧⲉⲙ: ⲁⲗⲗⲁ ⲛ̀ⲣⲉϥⲓ̀ⲣⲓ ⲟⲛ ⲛ̀ⲛⲉⲕⲟⲩⲁϩⲥⲁϩⲛⲓ ⲉⲑⲟⲩⲁⲃ: ⲕⲁⲧⲁ ⲡ̀ϯⲙⲁϯ ⲙ̀Ⲫ̀ⲛⲟⲩϯ Ⲡⲉⲕⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ."],"arabic":["+ وَافْتَحْ حَوَاسَّ نُفُوسِنَا: وَلْنَسْتَحِقَّ أَنْ نَكُونَ لَيْسَ فَقَطْ سَامِعِينَ: بَلْ عَامِلِينَ أَيْضاً بِأَوَامِرِكَ الْمُقَدَّسَةِ: كَمَسَرَّةِ اَللهِ أَبِيكَ الصَّالِحِ."],"arabized":["+ أووه آؤون إن ني إستيتيريون إنتى نينپسيشى: أووه مارين إيرپ إمپشا إن شوبي أو مونون إن ريف سوتيم: آللا إن ريف إيري أون إن نيك أوأه ساهني إثؤواب: كاتا إپ تيماتي إم إفنوتى فيك إيوت إن أغاثوس."],"english":["+ And open the senses of our souls: and may we be worthy to be not only hearers: but also doers of Your holy commandments: according to the good pleasure of God Your good Father."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲁ̀-ⲟⲩⲱⲛ","span":2},{"text":"قد – افتح (افتح)","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ⲉⲥⲑⲏⲧⲏⲣⲓⲟⲛ","span":1},{"text":"αἰσθητήριον","span":2},{"text":"(أداة ربط) – الـ – حواس (حواسنا)","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الخاص بـ","span":2}],[{"text":"ⲛⲉⲛ-ⲯⲏⲭⲏ","span":2},{"text":"ـنا – نفوس (نفوسنا)","span":2}],[{"text":"✠","span":4}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲙⲁⲣⲓ-ⲛ-ⲉⲣ-ⲡ̀ⲉⲙⲡ̀ϣⲁ","span":2},{"text":"فلنجعل – نحن – نعمل – استحقاق (فلنستحق)","span":2}],[{"text":"ⲛ̀-ϣⲱⲡⲓ","span":2},{"text":"(أداة ربط) – نكون (أن نكون)","span":2}],[{"text":"ⲟⲩ-ⲙⲟⲛⲟⲛ","span":1},{"text":"μόνον","span":2},{"text":"(أداة نكرة) – فقط","span":1}],[{"text":"ⲛ̀-ⲣⲉϥ-ⲥⲱⲧⲉⲙ","span":2},{"text":"(أداة ربط) – فاعل – سماع (سامعين)","span":2}],[{"text":"ⲁⲗⲗⲁ","span":1},{"text":"ἀλλά","span":2},{"text":"بل","span":1}],[{"text":"ⲛ̀-ⲣⲉϥ-ⲓ̀ⲣⲓ","span":2},{"text":"(أداة ربط) – فاعل – عمل (عاملين)","span":2}],[{"text":"ⲟⲛ","span":2},{"text":"أيضاً","span":2}],[{"text":"ⲛ̀-ⲛⲉ-ⲕ-ⲟⲩⲁϩⲥⲁϩⲛⲓ","span":2},{"text":"(أداة ربط) – الـ – ـك – وصايا (وصاياك)","span":2}],[{"text":"ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"الذي – مقدس (القدوس)","span":2}],[{"text":"ⲕⲁⲧⲁ","span":2},{"text":"حسب","span":2}],[{"text":"ⲡ̀-ϯⲙⲁϯ","span":2},{"text":"الـ – مسرة (مسرة)","span":2}],[{"text":"ⲙ̀-Ⲫ̀ⲛⲟⲩϯ","span":2},{"text":"(أداة ربط) – الـ – الله (الله)","span":2}],[{"text":"Ⲡⲉⲕ-ⲓⲱⲧ","span":2},{"text":"ـك – أب (أبيك)","span":2}],[{"text":"ⲛ̀-ⲁ̀ⲅⲁⲑⲟⲥ","span":1},{"text":"ἀγαθός","span":2},{"text":"(أداة ربط) – صالح (الصالح)","span":1}]]}],"files":[]}