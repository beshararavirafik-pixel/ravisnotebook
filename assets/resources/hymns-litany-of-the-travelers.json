{"id":"hymns-litany-of-the-travelers","units":[{"title":"Prayshleel","role":"priest","verses":{"coptic":["+ Ϣ̀ⲗⲏⲗ."],"arabic":["+ صَلِّ."],"english":["+ Pray."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣ̀ⲗⲏⲗ","span":2},{"text":"صَلِّ (صيغة أمر)","span":2}]],"sourceTitle":"صلِ"},{"title":"Stand for Prayer","role":"deacon","verses":{"coptic":["+ Ⲉ̀ⲡⲓ ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ ⲥ̀ⲧⲁⲑⲏⲧⲉ."],"arabic":["+ لِلصَّلَاةِ قِفُوا."],"english":["+ Stand up for prayer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀ⲡⲓ","span":1},{"text":"ἐπί","span":2},{"text":"لأجل، لغرض","span":1}],[{"text":"ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ","span":1},{"text":"προσευχή","span":2},{"text":"الصلاة (πρός (نحو، إلى) + εὐχή (صلاة، طلب) = προσευχή (الصلاة الموجهة نحو الله))","span":1}],[{"text":"ⲥ̀ⲧⲁⲑⲏⲧⲉ","span":1},{"text":"στάθητε","span":2},{"text":"قفوا، قوموا","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"للصلاة قفوا"},{"title":"Piecetoall Priest","role":"priest","verses":{"coptic":["+ Ⲓ̀ⲣⲏⲛⲏ ⲡⲁⲥⲓ."],"arabic":["+ اَلسَّلَامُ لِلْكُلِّ."],"english":["+ Peace be to all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲓ̀ⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲡⲁⲥⲓ","span":1},{"text":"πᾶσι","span":2},{"text":"للجميع (صيغة الجمع غير المباشر لـ πᾶς)","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"السلام للكل"},{"title":"And With Your Spirit","role":"people","verses":{"coptic":["+ Ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ."],"arabic":["+ وَلِرُوحِكَ."],"english":["+ And to Your Spirit."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲧⲱ","span":1},{"text":"τῷ","span":2},{"text":"مع الـ","span":1}],[{"text":"ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ","span":1},{"text":"πνεύματι","span":2},{"text":"روح","span":1}],[{"text":"ⲥⲟⲩ","span":1},{"text":"σου","span":2},{"text":"التي لك (روحك)","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"ولروحك"},{"title":"Litany Of The Travelers","role":"priest","verses":{"coptic":["+ Ⲧⲉⲛϯϩⲟ ⲟⲩⲟϩ ⲧⲉⲛⲧⲱⲃϩ ⲛ̀ⲧⲉⲕⲙⲉⲧⲁ̀ⲅⲁⲑⲟⲥ ⲡⲓⲙⲁⲓⲣⲱⲙⲓ: ⲁⲣⲓⲫⲙⲉⲩⲓ̀ Ⲡ̀ϭⲟⲓⲥ ⲛ̀ⲛⲉⲛⲓⲟϯ ⲛⲉⲙ ⲛⲉⲛⲥ̀ⲛⲏⲟⲩ ⲉ̀ⲧⲁⲩϣⲉ ⲉⲡ̀ϣⲉⲙⲙⲟ."],"arabic":["+ نَسْأَلُ وَنَطْلُبُ مِنْ صَلَاحِكَ يَا مُحِبَّ الْبَشَرِ: اُذْكُرْ يَا رَبُّ آبَاءَنَا وَإِخْوَتَنَا الْمُسَافِرِينَ."],"english":["+ We ask and beseech Your goodness O Lover of mankind: remember O Lord our fathers and our brethren who are traveling."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲧⲉⲛ-ϯ-ϩⲟ","span":2},{"text":"نحن – نعطي – وجه (نتضرع)","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"ⲧⲉⲛ-ⲧⲱⲃϩ","span":2},{"text":"نحن – نطلب (نطلب)","span":2}],[{"text":"ⲛ̀ⲧⲉ-ⲕ-ⲙⲉⲧ-ⲁ̀ⲅⲁⲑⲟⲥ","span":1},{"text":"ἀγαθός","span":2},{"text":"(أداة ربط) – ـك – (مقطع تجريد) – صالح (صلاحك)","span":1}],[{"text":"ⲡⲓ-ⲙⲁⲓ-ⲣⲱⲙⲓ","span":1},{"text":"φιλάνθρωπος","span":2},{"text":"الـ – محب – بشر (يا محب البشر)","span":1}],[{"text":"ⲁⲣⲓ-ⲫ-ⲙⲉⲩⲓ̀","span":2},{"text":"اصنع – الـ – ذكر (اذكر)","span":2}],[{"text":"Ⲡ̀-ϭⲟⲓⲥ","span":2},{"text":"الـ – رب","span":2}],[{"text":"ⲛ̀-ⲛⲉⲛ-ⲓⲟϯ","span":2},{"text":"(أداة ربط) – ـنا – آباء (آبائنا)","span":2}],[{"text":"ⲛⲉⲙ","span":2},{"text":"مع","span":2}],[{"text":"ⲛⲉⲛ-ⲥ̀ⲛⲏⲟⲩ","span":2},{"text":"ـنا – إخوة (إخوتنا)","span":2}],[{"text":"ⲉⲧ-ⲁⲩ-ϣⲉ","span":2},{"text":"الذين – هم قد – ذهبوا","span":2}],[{"text":"ⲉ-ⲡ̀-ϣⲉⲙⲙⲟ","span":2},{"text":"إلى – الـ – غربة (إلى الغربة)","span":2}]],"sourceTitle":"أوشية المسافرين"},{"title":"Response Of The Litany Of The Travelers","role":"deacon","verses":{"coptic":["+ Ⲧⲱⲃϩ ⲉ̀ϫⲉⲛ ⲛⲉⲛⲓⲟϯ ⲛⲉⲙ ⲛⲉⲛⲥ̀ⲛⲏⲟⲩ ⲉ̀ⲧⲁⲩϣⲉ ⲉ̀ⲡ̀ϣⲉⲙⲙⲟ: ⲓⲉ ⲛⲏⲉⲑⲙⲉⲩⲓ̀ ⲉ̀ϣⲉ ϧⲉⲛ ⲙⲁⲓ ⲛⲓⲃⲉⲛ: ⲥⲟⲩⲧⲱⲛ ⲛⲟⲩⲙⲱⲓⲧ ⲧⲏⲣⲟⲩ: ⲓ̀ⲧⲉ ⲉ̀ⲃⲟⲗ ϩⲓⲧⲉⲛ ⲫ̀ⲓⲟⲙ ⲓⲉ ⲛⲓⲓⲁⲣⲱⲟⲩ: ⲓⲉ ⲛⲓⲗⲩⲙⲛⲏ ⲓⲉ ⲛⲓⲙⲱⲓⲧ ⲙ̀ⲙⲟϣⲓ: ⲓⲉ ⲡⲓⲁ̀ⲏⲣ ⲓⲉ ⲉⲩⲓ̀ⲣⲓ ⲙ̀ⲡⲟⲩϫⲓⲛⲙⲟϣⲓ ⲛ̀ⲣⲏϯ ⲛⲓⲃⲉⲛ: ϩⲓⲛⲁ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲛⲟⲩϯ ⲧⲁⲥⲑⲱⲟⲩ ⲉ̀ⲛⲏⲉ̀ⲧⲉ ⲛⲟⲩⲟⲩ ⲙ̀ⲙⲁⲛ̀ϣⲱⲡⲓ ϧⲉⲛ ⲟⲩϩⲓⲣⲏⲛⲏ: ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ."],"arabic":["+ اُطْلُبُوا عَنْ آبَائِنَا وَإِخْوَتِنَا اَلْمُسَافِرِينَ: وَاَلَّذِينَ يُضْمِرُونَ اَلسَّفَرَ فِي كُلِّ مَوْضِعٍ: لِ