{"id":"hymns-voc-andrew-apost","units":[{"title":"أرباع الناقوس لأندراوس الرسول","role":"people","verses":{"coptic":["+ Ⲭⲉⲣⲉ ⲡⲁϭⲟⲓⲥ ⲛ̀ⲓⲱⲧ: ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ: ⲭⲉⲣⲉ ⲡⲓⲙⲁⲑⲏⲧⲏⲥ: Ⲁⲛⲇⲣⲉⲁⲥ ⲡⲓⲡⲣⲱⲧⲟⲕⲗⲏⲧⲟⲥ."],"arabic":["+ اَلسَّلَامُ لِسَيِّدِي اَلْأَبِ: اَلرَّسُولِ: اَلسَّلَامُ لِلتِّلْمِيذِ: أَنْدَرَاوُسَ أَوَّلِ اَلْمَدْعُوِّينَ."],"english":["+ Hail to my lord the father: the apostle: Hail to the disciple: Andrew, the first-called."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲭⲉⲣⲉ","span":1},{"text":"χαῖρε","span":2},{"text":"افرح / السلام","span":1}],[{"text":"ⲡⲁ-ϭⲟⲓⲥ","span":2},{"text":"يا - سيدي (يا سيدي)","span":2}],[{"text":"ⲛ̀-ⲓⲱⲧ","span":1},{"text":"πατήρ → πατέρες","span":2},{"text":"(أداة ربط صفة) - آباء","span":1}],[{"text":"ⲛ̀-ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ","span":1},{"text":"ἀπόστολος","span":2},{"text":"(أداة ربط صفة) - رسل","span":1}],[{"text":"✠","span":4}],[{"text":"ⲭⲉⲣⲉ","span":1},{"text":"χαῖρε","span":2},{"text":"افرح / السلام","span":1}],[{"text":"ⲡⲓ-ⲙⲁⲑⲏⲧⲏⲥ","span":1},{"text":"μαθητής","span":2},{"text":"الـ - تلميذ (التلميذ)","span":1}],[{"text":"✠","span":4}],[{"text":"Ⲁⲛⲇⲣⲉⲁⲥ","span":1},{"text":"Ἀνδρέας","span":2},{"text":"أندراوس","span":1}],[{"text":"ⲡⲓ-ⲡⲣⲱⲧⲟⲕⲗⲏⲧⲟⲥ","span":1},{"text":"πρωτόκλητος","span":2},{"text":"الـ - أول المدعوين (الأول المدعو)","span":1}]]}],"files":[]}
