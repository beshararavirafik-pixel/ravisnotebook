ا."],"english":["+ And our father the bishop (the metropolitan) or our fathers the bishops who are with us."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲡⲉⲛ-ⲓⲱⲧ","span":2},{"text":"ـنا – أب (أبونا)","span":2}],[{"text":"ⲓⲉ","span":2},{"text":"أو","span":2}],[{"text":"ⲛⲉⲛ-ⲓⲟϯ","span":2},{"text":"ـنا – آباء (آباؤنا)","span":2}],[{"text":"ⲛ̀-ⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ","span":1},{"text":"ἐπίσκοπος","span":2},{"text":"(أداة ربط للإضافة) – أسقف (الأسقف)","span":1}],[{"text":"ⲙ̀-ⲙⲏⲧⲣⲟⲡⲟⲗⲓⲧⲏⲥ","span":1},{"text":"μητροπολίτης","span":2},{"text":"(أداة ربط للإضافة) – مطران (المطران)","span":1}],[{"text":"ⲁⲃⲃⲁ","span":1},{"text":"ἀββᾶ / אַבָּא","span":2},{"text":"أب (أبانا)","span":1}],[{"text":"ⲛⲓⲙ","span":2},{"text":"أي (أي)","span":2}],[{"text":"ⲓⲉ","span":2},{"text":"أو","span":2}],[{"text":"ⲛⲏ-ⲉⲧ-ⲭⲏ","span":2},{"text":"أولئك – الذين – موجودون (الذين معنا)","span":2}],[{"text":"ⲛⲉⲙⲁⲛ","span":2},{"text":"معنا","span":2}]]},{"title":"فقرة مخصصة","role":"people","verses":{"coptic":["+ Ⲫ̀ⲛⲟⲩϯ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ ⲉϥⲉ̀ⲧⲁϫⲣⲟϥ (ⲉϥⲉ̀ⲧⲁϫⲣⲱⲟⲩ) ϩⲓϫⲉⲛ ⲡⲉϥⲑ̀ⲣⲟⲛⲟⲥ (ⲛⲟⲩⲑ̀ⲣⲟⲛⲟⲥ): ⲛ̀ϩⲁⲛⲙⲏϣ ⲛ̀ⲣⲟⲙⲡⲓ ⲛⲉⲙ ϩⲁⲛⲥⲏⲟⲩ ⲛ̀ϩⲓⲣⲏⲛⲓⲕⲟⲛ.","+ Ⲛ̀ⲧⲉϥⲑⲉⲃⲓⲟ ⲛ̀ⲛⲉϥϫⲁϫⲓ (ⲛ̀ⲛⲟⲩϫⲁϫⲓ) ⲧⲏⲣⲟⲩ ⲥⲁⲡⲉⲥⲏⲧ ⲛ̀ⲛⲉϥϭⲁⲗⲁⲩϫ (ⲛ̀ⲛⲟⲩϭⲁⲗⲁⲩϫ) ⲛ̀ⲭⲱⲗⲉⲙ.","+ Ⲧⲱⲃϩ ⲉ̀Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ: ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲟⲩϩⲓⲣⲏⲛⲏ ⲕⲁⲧⲁ ⲡⲉϥⲛⲓϣϯ ⲛ̀ⲛⲁⲓ."],"arabic":["+ إِلَهُ السَّمَاءِ يُثَبِّتُهُ عَلَى كُرْسِيِّهِ سِنِينَ كَثِيرَةً وَأَزْمِنَةً سَلَامِيَّةً.","+ وَيُخْضِعُ جَمِيعَ أَعْدَائِهِ تَحْتَ قَدَمَيْهِ سَرِيعًا.","+ أَطْلُبُ مِنَ الْمَسِيحِ عَنَّا لِيَغْفِرَ لَنَا خَطَايَانَا بِسَلَامٍ كَعَظِيمِ رَحْمَتِهِ."],"english":["+ The God of heaven shall establish him upon His throne for many years: and for peaceful times.","+ And He shall subject all His enemies under His feet: speedily.","+ I beseech Christ on our behalf: that He may forgive us our sins in peace: according to His great mercy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲫ̀-ⲛⲟⲩϯ","span":2},{"text"