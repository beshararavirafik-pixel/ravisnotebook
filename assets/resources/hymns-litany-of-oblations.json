{"id":"hymns-litany-of-oblations","units":[{"title":"Prayshleel","role":"priest","verses":{"coptic":["+ Ϣ̀ⲗⲏⲗ."],"arabic":["+ صَلِّ."],"english":["+ Pray."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣ̀ⲗⲏⲗ","span":2},{"text":"صَلِّ (صيغة أمر)","span":2}]],"sourceTitle":"صلِ"},{"title":"Stand for Prayer","role":"deacon","verses":{"coptic":["+ Ⲉ̀ⲡⲓ ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ ⲥ̀ⲧⲁⲑⲏⲧⲉ."],"arabic":["+ لِلصَّلَاةِ قِفُوا."],"english":["+ Stand up for prayer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲉ̀ⲡⲓ","span":1},{"text":"ἐπί","span":2},{"text":"لأجل، لغرض","span":1}],[{"text":"ⲡ̀ⲣⲟⲥⲉⲩⲭⲏ","span":1},{"text":"προσευχή","span":2},{"text":"الصلاة (πρός (نحو، إلى) + εὐχή (صلاة، طلب) = προσευχή (الصلاة الموجهة نحو الله))","span":1}],[{"text":"ⲥ̀ⲧⲁⲑⲏⲧⲉ","span":1},{"text":"στάθητε","span":2},{"text":"قفوا، قوموا","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"للصلاة قفوا"},{"title":"Piecetoall Priest","role":"priest","verses":{"coptic":["+ Ⲓ̀ⲣⲏⲛⲏ ⲡⲁⲥⲓ."],"arabic":["+ اَلسَّلَامُ لِلْكُلِّ."],"english":["+ Peace be to all."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲓ̀ⲣⲏⲛⲏ","span":1},{"text":"εἰρήνη","span":2},{"text":"سلام","span":1}],[{"text":"ⲡⲁⲥⲓ","span":1},{"text":"πᾶσι","span":2},{"text":"للجميع (صيغة الجمع غير المباشر لـ πᾶς)","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"السلام للكل"},{"title":"And With Your Spirit","role":"people","verses":{"coptic":["+ Ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ."],"arabic":["+ وَلِرُوحِكَ."],"english":["+ And to Your Spirit."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲉ","span":1},{"text":"καί","span":2},{"text":"و","span":1}],[{"text":"ⲧⲱ","span":1},{"text":"τῷ","span":2},{"text":"مع الـ","span":1}],[{"text":"ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ","span":1},{"text":"πνεύματι","span":2},{"text":"روح","span":1}],[{"text":"ⲥⲟⲩ","span":1},{"text":"σου","span":2},{"text":"التي لك (روحك)","span":1}],[{"text":"✠","span":4}]],"sourceTitle":"ولروحك"},{"title":"Litany Of Oblations","role":"priest","verses":{"coptic":["+ Ⲧⲉⲛϯϩⲟ ⲟⲩⲟϩ ⲧⲉⲛⲧⲱⲃϩ ⲛ̀ⲧⲉⲕⲙⲉⲧⲁ̀ⲅⲁⲑⲟⲥ ⲡⲓⲙⲁⲓⲣⲱⲙⲓ: ⲁ̀ⲣⲓⲫⲙⲉⲩⲓ̀ Ⲡϭⲟⲓⲥ ⲛ̀ⲛⲓⲑⲩⲥⲓⲁ ⲛⲓⲡ̀ⲣⲟⲥⲫⲟⲣⲁ: ⲡⲓϣⲉⲡϩ̀ⲙⲟⲧ ⲛ̀ⲧⲉ ⲛⲏⲉ̀ⲧⲁⲩⲉⲣⲡ̀ⲣⲟⲥⲫⲉⲣⲓⲛ."],"arabic":["+ نَسْأَلُ وَنَطْلُبُ مِنْ صَلَاحِكَ يَا مُحِبَّ الْبَشَرِ: اُذْكُرْ يَا رَبُّ صَعَائِدَ وَقَرَابِينَ وَشُكْرَ الَّذِينَ يُقَرِّبُونَ."],"english":["+ We ask and beseech Your goodness O Lover of mankind: Remember O Lord the offerings and the sacrifices and the thanksgiving of those who offer."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲧⲉⲛ-ϯϩⲟ","span":2},{"text":"نحن – نسأل (نطلب)","span":2}],[{"text":"ⲟⲩⲟϩ","span":2},{"text":"و","span":2}],[{"text":"Ⲧⲉⲛ-ⲧⲱⲃϩ","span":2},{"text":"نحن – نتضرع (نتضرع)","span":2}],[{"text":"ⲛ̀-ⲧⲉⲕ-ⲙⲉⲧⲁ̀ⲅⲁⲑⲟⲥ","span":1},{"text":"ἀγαθός","span":2},{"text":"(أداة ربط للإضافة) – ـك – صلاح (صلاحك)","span":1}],[{"text":"ⲡⲓ-ⲙⲁⲓⲣⲱⲙⲓ","span":2},{"text":"الـ – محب البشر","span":2}],[{"text":"✠","span":4}],[{"text":"ⲁ̀ⲣⲓ-ⲫⲙⲉⲩⲓ̀","span":2},{"text":"اصنع – ذكر (اذكر)","span":2}],[{"text":"Ⲡ-ϭⲟⲓⲥ","span":2},{"text":"الـ – رب (الرب)","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ⲑⲩⲥⲓⲁ","span":1},{"text":"θυσία","span":2},{"text":"(أداة ربط للإضافة) – الـ – ذبائح (الذبائح)","span":1}],[{"text":"ⲛⲓ-ⲡ̀ⲣⲟⲥⲫⲟⲣⲁ","span":1},{"text":"προσφορά","span":2},{"text":"الـ – تقدمات (التقدمات)","span":1}],[{"text":"✠","span":4}],[{"text":"ⲡⲓ-ϣⲉⲡϩ̀ⲙⲟⲧ","span":2},{"text":"الـ – شكر (الشكر)","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط للإضافة)","span":2}],[{"text":"ⲛⲏ-ⲉ̀ⲧⲁⲩ-ⲉⲣ-ⲡ̀ⲣⲟⲥⲫⲉⲣⲓⲛ","span":2},{"text":"أولئك – الذين هم قد – عملوا – تقدمة (الذين قدموا)","span":2}]],"sourceTitle":"أوشية القرابين"},{"title":"Additional Verse","role":"priest","verses":{"coptic":["+ ⲉ̀ⲟⲩⲧⲁⲓⲟ ⲛⲉⲙ ⲟⲩⲱ̀ⲟⲩ ⲙ̀ⲡⲉⲕⲣⲁⲛ ⲉⲑⲟⲩⲁⲃ."],"arabic":["+ كَرَامَةً وَمَجْدًا لِاسْمِكَ الْقُدُّوسِ."],"english":["+ Honor and glory to Your Holy Name."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"ⲉ̀-ⲟⲩ-ⲧⲁⲓⲟ","span":1},{"text":"τιμή","span":2},{"text":"لـ – (أداة تنكير) – كرامة (لكرامة)","span":1}],[{"text":"ⲛⲉⲙ","span":2},{"text":"و","span":2}],[{"text":"ⲟⲩ-ⲱ̀ⲟⲩ","span":2},{"text":"(أداة تنكير) – مجد (ومجد)","span":2}],[{"text":"ⲙ̀-ⲡⲉⲕ-ⲣⲁⲛ","span":2},{"text":"(أداة ربط للإضافة) – ـك – اسم (لاسمك)","span":2}],[{"text":"ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"الذي – مقدس (القدوس)","span":2}]],"sourceTitle":"فقرة مخصصة"},{"title":"Response to the Litany of the Oblations","role":"deacon","verses":{"coptic":["+ Ⲧⲱⲃϩ ⲉ̀ϫⲉⲛ ⲛⲏⲉⲧϥⲓ ⲙ̀ⲫ̀ⲣⲱⲟⲩϣ ⲛ̀ⲛⲓⲑⲩⲥⲓⲁ ⲛⲓⲡ̀ⲣⲟⲥⲫⲟⲣⲁ ⲛⲓⲁ̀ⲡⲁⲣⲭⲏ ⲛⲓⲛⲉϩ ⲛⲓⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ ⲛⲓⲥ̀ⲕⲉⲡⲁⲥⲙⲁ ⲛⲓϫⲱⲙ ⲛ̀ⲱϣ ⲛⲓⲕⲩⲙⲓⲗⲗⲓⲟⲛ ⲛ̀ⲧⲉ ⲡⲓⲙⲁⲛ̀ⲉⲣϣⲱⲟⲩϣⲓ: ϩⲓⲛⲁ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲛⲟⲩϯ ϯϣⲉⲃⲓⲱ ⲛⲱⲟⲩ ϧⲉⲛ Ⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ: ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ."],"arabic":["+ اُطْلُبُوا عَنِ الْمُهْتَمِّينَ بِالصَّعَائِدِ وَالْقَرَابِينِ وَالْبُكُورِ وَالزُّيُوتِ وَالْبَخُورِ وَالسُّتُورِ وَكُتُبِ الْقِرَاءَةِ وَأَوَانِي الْمَذْبَحِ: لِكَيْ اَلْمَسِيحُ اِلَهُنَا يُكَافِئَهُمْ فِي أُورُشَلِيمَ السَّمَائِيَّةِ: وَيَغْفِرَ لَنَا خَطَايَانَا."],"english":["+ Pray for those who care for the offerings, the sacrifices, the firstfruits, the oils, the incense, the veils, and the books of reading, and the vessels of the altar: so that Christ our God may reward them in the heavenly Jerusalem: and forgive us our sins."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲧⲱⲃϩ","span":2},{"text":"اطلبوا (صلوا)","span":2}],[{"text":"ⲉ̀ϫⲉⲛ","span":2},{"text":"من أجل (على)","span":2}],[{"text":"ⲛⲏ-ⲉⲧ-ϥⲓ","span":2},{"text":"الذين – (اسم موصول) – يحملون","span":2}],[{"text":"ⲙ̀-ⲫ̀-ⲣⲱⲟⲩϣ","span":2},{"text":"(أداة ربط مفعول به) – الـ – عناية","span":2}],[{"text":"ⲛ̀-ⲛⲓ-ⲑⲩⲥⲓⲁ","span":1},{"text":"θυσία","span":2},{"text":"(أداة ربط للإضافة) – الـ – ذبائح","span":1}],[{"text":"ⲛⲓ-ⲡ̀ⲣⲟⲥⲫⲟⲣⲁ","span":1},{"text":"προσφορά","span":2},{"text":"الـ – قرابين","span":1}],[{"text":"ⲛⲓ-ⲁ̀ⲡⲁⲣⲭⲏ","span":1},{"text":"ἀπαρχή","span":2},{"text":"الـ – بواكير","span":1}],[{"text":"ⲛⲓ-ⲛⲉϩ","span":2},{"text":"الـ – زيت (زيوت)","span":2}],[{"text":"ⲛⲓ-ⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ","span":2},{"text":"الـ – بخور","span":2}],[{"text":"ⲛⲓ-ⲥ̀ⲕⲉⲡⲁⲥⲙⲁ","span":1},{"text":"σκέπασμα","span":2},{"text":"الـ – ستور","span":1}],[{"text":"ⲛⲓ-ϫⲱⲙ","span":2},{"text":"الـ – كتب","span":2}],[{"text":"ⲛ̀-ⲱϣ","span":2},{"text":"(أداة ربط صفة) – قراءة","span":2}],[{"text":"ⲛⲓ-ⲕⲩⲙⲓⲗⲗⲓⲟⲛ","span":1},{"text":"κειμήλιον","span":2},{"text":"الـ – أواني (أدوات ثمينة)","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط للإضافة)","span":2}],[{"text":"ⲡⲓ-ⲙⲁⲛ̀-ⲉⲣϣⲱⲟⲩϣⲓ","span":2},{"text":"الـ – مكان – مذبح (المذبح)","span":2}],[{"text":"ϩⲓⲛⲁ","span":1},{"text":"ἵνα","span":2},{"text":"لكي","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط فعلية)","span":2}],[{"text":"Ⲡⲭ̅ⲥ̅ : Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ","span":1},{"text":"Χριστός","span":2},{"text":"الـ – مسيح","span":1}],[{"text":"Ⲡⲉⲛ-ⲛⲟⲩϯ","span":2},{"text":"ـنا – إله (إلهنا)","span":2}],[{"text":"ϯ-ϣⲉⲃⲓⲱ","span":2},{"text":"يعطي – مكافأة (عوضاً)","span":2}],[{"text":"ⲛⲱⲟⲩ","span":2},{"text":"لـهم","span":2}],[{"text":"ϧⲉⲛ","span":2},{"text":"في","span":2}],[{"text":"Ⲓⲗ̅ⲏ̅ⲙ̅ : Ⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ","span":1},{"text":"יְרוּשָׁלַיִם / Ἰερουσαλήμ","span":2},{"text":"أورشليم","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"(أداة ربط للإضافة)","span":2}],[{"text":"ⲧ̀-ⲫⲉ","span":2},{"text":"الـ – سماء","span":2}],[{"text":"ⲛ̀ⲧⲉϥ-ⲭⲁ","span":2},{"text":"لكي هو – يغفر (يترك)","span":2}],[{"text":"ⲛⲉⲛ-ⲛⲟⲃⲓ","span":2},{"text":"ـنا – خطايا (خطايانا)","span":2}],[{"text":"ⲛⲁⲛ","span":2},{"text":"لنا","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"غفراناً (إلى الخارج)","span":2}]],"sourceTitle":"خاص: مرد أوشية القرابين"},{"title":"Lord Have Mercy","role":"people","verses":{"coptic":["+ Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ."],"arabic":["+ يَا رَبُّ ارْحَمْ."],"english":["+ Lord have mercy."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ⲕⲩⲣⲓⲉ","span":1},{"text":"κύριε","span":2},{"text":"يا رب","span":1}],[{"text":"ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ","span":1},{"text":"ἐλέησον","span":2},{"text":"ارحم","span":1}]],"sourceTitle":"يا رب ارحم"},{"title":"Additional Verse","role":"priest","verses":{"coptic":["+ Ϣⲟⲡⲟⲩ ⲉ̀ⲣⲟⲕ ⲉ̀ϫⲉⲛ ⲡⲉⲕⲑⲩⲥⲓⲁⲥⲧⲏⲣⲓⲟⲛ ⲉⲑⲟⲩⲁⲃ ⲛ̀ⲉⲗⲗⲟⲅⲓⲙⲟⲛ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ: ⲉ̀ⲟⲩⲥ̀ⲑⲟⲓ ⲛ̀ⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ: ⲉ̀ϧⲟⲩⲛ ⲉ̀ⲧⲉⲕⲙⲉⲧⲛⲓϣϯ ⲉⲧϧⲉⲛ ⲛⲓⲫⲏⲟⲩⲓ: ⲉ̀ⲃⲟⲗ ϩⲓⲧⲉⲛ ⲡ̀ϣⲉⲙϣⲓ ⲛ̀ⲧⲉ ⲛⲉⲕⲁⲅⲅⲉⲗⲟⲥ ⲛⲉⲙ ⲛⲉⲕⲁⲣⲭⲓⲁⲅⲅⲉⲗⲟⲥ ⲉⲑⲟⲩⲁⲃ.","+ Ⲙⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁⲕϣⲱⲡ ⲉ̀ⲣⲟⲕ ⲛ̀ⲛⲓⲇⲱⲣⲟⲛ ⲛ̀ⲧⲉ ⲡⲓⲑ̀ⲙⲏⲓ Ⲁⲃⲉⲗ: ⲛⲉⲙ ϯⲑⲩⲥⲓⲁ ⲛ̀ⲧⲉ ⲡⲉⲛⲓⲱⲧ Ⲁⲃⲣⲁⲁⲙ ⲛⲉⲙ ϯⲧⲉⲃⲓ ⲥ̀ⲛⲟⲩϯ ⲛ̀ⲧⲉ ϯⲭⲏⲣⲁ.","+ Ⲡⲁⲓⲣⲏϯ ⲟⲛ ⲛⲓⲕⲉⲉⲩⲭⲁⲣⲓⲥⲧⲏⲣⲓⲟⲛ ⲛ̀ⲧⲉ ⲛⲉⲕⲉ̀ⲃⲓⲁⲓⲕ ϣⲟⲡⲟⲩ ⲉ̀ⲣⲟⲕ: ⲛⲁ ⲡⲓϩⲟⲩⲟ̀ ⲛⲉⲙ ⲛⲁ ⲡⲓⲕⲟⲩϫⲓ: ⲛⲏⲉⲧϩⲏⲡ ⲛⲉⲙ ⲛⲏⲉⲑⲟⲩⲱⲛϩ ⲉ̀ⲃⲟⲗ.","+ Ⲛⲏⲉⲑⲟⲩⲱϣ ⲉ̀ⲓ̀ⲛⲓ ⲛⲁⲕ ⲉ̀ϧⲟⲩⲛ ⲟⲩⲟϩ ⲙ̀ⲙⲟⲛ ⲛ̀ⲧⲱⲟⲩ: ⲛⲉⲙ ⲛⲏⲉ̀ⲧⲁⲩⲓ̀ⲛⲓ ⲛⲁⲕ ⲉ̀ϧⲟⲩⲛ ϧⲉⲛ ⲡⲁⲓⲉ̀ϩⲟⲟⲩ ⲛ̀ⲧⲉ ⲫⲟⲟⲩ ⲛ̀ⲛⲁⲓⲇⲱⲣⲟⲛ ⲛⲁⲓ.","+ Ⲙⲟⲓ ⲛⲱⲟⲩ ⲛ̀ⲛⲓⲁⲧⲧⲁⲕⲟ ⲛ̀ⲧ̀ϣⲉⲃⲓⲱ ⲛ̀ⲛⲏⲉⲑⲛⲁⲧⲁⲕⲟ: ⲛⲁ ⲛⲓⲫⲏⲟⲩⲓ ⲛ̀ⲧ̀ϣⲉⲃⲓⲱ ⲛ̀ⲛⲁⲡ̀ⲕⲁϩⲓ: ⲛⲓϣⲁⲉ̀ⲛⲉϩ ⲛ̀ⲧ̀ϣⲉⲃⲓⲱ ⲛ̀ⲛⲓⲡ̀ⲣⲟⲥⲟⲩⲥⲏⲟⲩ.","+ Ⲛⲟⲩⲏⲟⲩ ⲛⲟⲩⲧⲁⲙⲓⲟⲛ ⲙⲁϩⲟⲩ ⲉ̀ⲃⲟⲗϧⲉⲛ ⲁ̀ⲅⲁⲑⲟⲛ ⲛⲓⲃⲉⲛ."],"arabic":["+ اِقْبَلْهَا إِلَيْكَ عَلَى مَذْبَحِكَ اَلْمُقَدَّسِ: اَلنَّاطِقِ اَلسَّمَائِيِّ رَائِحَةَ بَخُورٍ: تَدْخُلُ إِلَى عَظَمَتِكَ اَلَّتِي فِي اَلسَّمَاوَاتِ بِوَاسِطَةِ خِدْمَةِ مَلَائِكَتِكَ: وَرُؤَسَاءِ مَلَائِكَتِكَ اَلْمُقَدَّسِينَ.","+ وَكَمَا قَبِلْتَ إِلَيْكَ قَرَابِينَ هَابِيلَ اَلصِّدِّيقِ: وَذَبِيحَةَ أَبِينَا إِبْرَاهِيمَ: وَفِلْسَيِ اَلْأَرْمَلَةِ.","+ هَكَذَا أَيْضاً نُذُورَ عَبِيدِكَ اِقْبَلْهَا إِلَيْكَ: أَصْحَابَ اَلْكَثِيرِ وَأَصْحَابَ اَلْقَلِيلِ: اَلْخَفِيَّاتِ وَالظَّاهِرَاتِ.","+ وَالَّذِينَ يُرِيدُونَ أَنْ يُقَدِّمُوا لَكَ وَلَيْسَ لَهُمْ: وَالَّذِينَ قَدَّمُوا لَكَ فِي هَذَا اَلْيَوْمِ هَذِهِ اَلْقَرَابِينَ.","+ أَعْطِهِمُ اَلْبَاقِيَاتِ عِوَضاً عَنِ اَلْفَانِيَاتِ: اَلسَّمَاوِيَّاتِ عِوَضَ اَلْأَرْضِيَّاتِ: اَلْأَبَدِيَّاتِ عِوَضَ اَلزَّمَنِيَّاتِ.","+ بُيُوتَهُمْ وَمَخَازِنَهُمْ اِمْلَأْهَا مِنْ كُلِّ اَلْخَيْرَاتِ."],"english":["+ Accept them unto Yourself upon Your holy altar: the rational heavenly one as a fragrance of incense: entering into Your majesty which is in the heavens through the ministry of Your angels: and Your holy archangels.","+ And as You accepted unto Yourself the offerings of Abel the righteous: and the sacrifice of our father Abraham: and the two mites of the widow.","+ Likewise accept the vows of Your servants unto Yourself: those who have much and those who have little: the hidden and the manifest.","+ And those who desire to offer unto You but have not: and those who have offered unto You on this day these offerings.","+ Grant them the everlasting in exchange for the perishable: the heavenly in exchange for the earthly: the eternal in exchange for the temporal.","+ Fill their houses and their storehouses with all good things."]},"analysis":[[{"text":"Ⲡⲓⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲡⲓϩⲩⲙⲛⲟⲥ","span":4}],[{"text":"Ϣⲟⲡ-ⲟⲩ","span":2},{"text":"اقبل – ـهم (اقبلهم)","span":2}],[{"text":"ⲉ̀ⲣⲟⲕ","span":2},{"text":"إليك","span":2}],[{"text":"ⲉ̀ϫⲉⲛ","span":2},{"text":"على","span":2}],[{"text":"ⲡⲉⲕ-ⲑⲩⲥⲓⲁⲥⲧⲏⲣⲓⲟⲛ","span":1},{"text":"θυσιαστήριον","span":2},{"text":"ـك – مذبح (مذبحك)","span":1}],[{"text":"ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"الذي – مقدس (المقدس)","span":2}],[{"text":"ⲛ̀-ⲉⲗⲗⲟⲅⲓⲙⲟⲛ","span":1},{"text":"ἐλλόγιμον","span":2},{"text":"(أداة ربط) – ناطق (الناطق)","span":1}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الخاص بـ","span":2}],[{"text":"ⲧ̀-ⲫⲉ","span":2},{"text":"الـ – سماء (السماء)","span":2}],[{"text":"ⲉ̀-ⲟⲩ-ⲥ̀ⲑⲟⲓ","span":2},{"text":"كـ – (أداة نكرة) – رائحة","span":2}],[{"text":"ⲛ̀-ⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ","span":2},{"text":"(أداة ربط) – طيبة (رائحة طيبة)","span":2}],[{"text":"ⲉ̀ϧⲟⲩⲛ","span":2},{"text":"إلى الداخل","span":2}],[{"text":"ⲉ̀-ⲧⲉⲕ-ⲙⲉⲧⲛⲓϣϯ","span":2},{"text":"إلى – ـك – عظمة (عظمتك)","span":2}],[{"text":"ⲉⲧ-ϧⲉⲛ","span":2},{"text":"التي – في","span":2}],[{"text":"ⲛⲓ-ⲫⲏⲟⲩⲓ","span":2},{"text":"الـ – سماوات","span":2}],[{"text":"ⲉ̀ⲃⲟⲗ","span":2},{"text":"بواسطة","span":2}],[{"text":"ϩⲓⲧⲉⲛ","span":2},{"text":"بواسطة","span":2}],[{"text":"ⲡ̀-ϣⲉⲙϣⲓ","span":2},{"text":"الـ – خدمة","span":2}],[{"text":"ⲛ̀ⲧⲉ","span":2},{"text":"الخاص بـ","span":2}],[{"text":"ⲛⲉⲕ-ⲁⲅⲅⲉⲗⲟⲥ","span":1},{"text":"ἄγγελος","span":2},{"text":"ـك – ملائكة (ملائكتك)","span":1}],[{"text":"ⲛⲉⲕ-ⲁⲣⲭⲓⲁⲅⲅⲉⲗⲟⲥ","span":1},{"text":"ἀρχάγγελος","span":2},{"text":"ـك – رؤساء ملائكة (رؤساء ملائكتك)","span":1}],[{"text":"ⲉⲑ-ⲟⲩⲁⲃ","span":2},{"text":"الذي – مقدس (القديسين)","span"